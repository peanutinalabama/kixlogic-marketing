---
// Layout for Kixlogic the firm (HR services, consulting, direct-hire recruiting, AI-enabled applications).
// Modelled on westmonroe.com: white header, deep navy type, uppercase display headlines with a yellow
// highlight, IBM Plex Mono for navigation, labels and buttons, outlined pill buttons, soft gradient hero.
// Self-contained on purpose: it does not load global.css, so the older app and legal pages keep their look.
import { SERVICES, INDUSTRIES } from '../data/firm';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}
const { title, description, canonical = Astro.url.href, noindex = false } = Astro.props;
const fullTitle = title === 'Kixlogic' ? 'Kixlogic | HR consulting, direct-hire recruiting and AI applications' : `${title} | Kixlogic`;
const image = new URL('/og-default.png', Astro.site).href;
const path = Astro.url.pathname;
const on = (p: string) => (path === p || path.startsWith(p) ? 'on' : '');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" sizes="32x32" href="/kx-icon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/kx-icon-192.png" />
  <link rel="apple-touch-icon" href="/kx-icon-180.png" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Kixlogic" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta name="twitter:card" content="summary_large_image" />
  <slot name="head" />
</head>
<body class="firm">
  <a class="skip" href="#main">Skip to content</a>
  <header class="fh">
    <div class="fw fh-in">
      <a href="/" class="fh-logo" aria-label="Kixlogic home"><img src="/kx-logo.png" alt="Kixlogic" width="159" height="40" /></a>
      <nav class="fh-nav" aria-label="Main" id="fhNav">
        <div class="fh-item">
          <button class={`fh-link ${on('/services/')}`} aria-expanded="false" aria-controls="m-services">Services</button>
          <div class="fh-menu" id="m-services">
            {SERVICES.map((s) => <a href={`/services/${s.slug}/`}><b>{s.name}</b><span>{s.line}</span></a>)}
          </div>
        </div>
        <div class="fh-item">
          <button class={`fh-link ${on('/industries/')}`} aria-expanded="false" aria-controls="m-industries">Industries</button>
          <div class="fh-menu" id="m-industries">
            {INDUSTRIES.map((s) => <a href={`/industries/${s.slug}/`}><b>{s.name}</b><span>{s.line}</span></a>)}
          </div>
        </div>
        <a class={`fh-link ${on('/about/')}`} href="/about/">About</a>
        <a class={`fh-link ${on('/blog/')}`} href="/blog/">Insights</a>
        <a class="fh-link fh-phone" href="/contact/">Contact us</a>
      </nav>
      <div class="fh-right">
        <a class="pill" href="/contact/">Contact us</a>
        <button class="fh-burger" aria-label="Open menu" aria-expanded="false" aria-controls="fhNav">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="ff">
    <div class="fw ff-grid">
      <div class="ff-brand">
        <img class="ff-logo" src="data:image/png;base64," alt="Kixlogic" width="127" height="32" />
        <p>HR services and consulting, direct-hire recruiting for IT, engineering and life sciences, and AI-enabled applications.</p>
        <a class="pill pill-sm" href="/contact/">Contact us</a>
      </div>
      <div>
        <h4>Services</h4>
        {SERVICES.map((s) => <a href={`/services/${s.slug}/`}>{s.name}</a>)}
      </div>
      <div>
        <h4>Industries</h4>
        {INDUSTRIES.map((s) => <a href={`/industries/${s.slug}/`}>{s.name}</a>)}
      </div>
      <div>
        <h4>Company</h4>
        <a href="/about/">About</a>
        <a href="/blog/">Insights</a>
        <a href="/contact/">Contact</a>
        <a href="/support/">Support</a>
      </div>
      <div>
        <h4>Apps we build</h4>
        <a href="/flipbookiq/">FlipbookIQ</a>
        <a href="/hero/">Kixlogic Hero</a>
        <a href="/renumify/">Renumify</a>
        <a href="/lilyfi/">LilyFi</a>
      </div>
    </div>
    <div class="fw ff-base">
      <span>© {new Date().getFullYear()} Kixlogic, LLC</span>
      <span><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/security/">Security</a></span>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var items = document.querySelectorAll('.fh-item > button');
      function closeAll(except) { items.forEach(function (b) { if (b !== except) b.setAttribute('aria-expanded', 'false'); }); }
      items.forEach(function (b) {
        b.addEventListener('click', function (e) { e.stopPropagation(); var open = b.getAttribute('aria-expanded') === 'true'; closeAll(b); b.setAttribute('aria-expanded', open ? 'false' : 'true'); });
      });
      document.addEventListener('click', function () { closeAll(null); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(null); });
      var burger = document.querySelector('.fh-burger'), nav = document.getElementById('fhNav');
      if (burger && nav) burger.addEventListener('click', function () { var o = nav.classList.toggle('open'); burger.setAttribute('aria-expanded', o ? 'true' : 'false'); });
    })();
  </script>

  <style is:global>
    .firm{--navy:#0A1B4D;--ink:#0A1B4D;--muted:#4B5677;--blue:#2F7DE1;--blue-deep:#1D5FC0;--hi:#F5E61B;--line:#DDE3F0;--soft:#F4F7FD;
      margin:0;font-family:"IBM Plex Sans",system-ui,sans-serif;color:var(--ink);background:#fff;line-height:1.6;-webkit-font-smoothing:antialiased}
    .firm *{box-sizing:border-box}
    .firm a{color:inherit}
    .firm .fw{max-width:1200px;margin:0 auto;padding:0 32px}
    .firm .skip{position:absolute;left:-999px}.firm .skip:focus{left:16px;top:16px;background:#fff;padding:8px 12px;z-index:100}
    .firm .mono{font-family:"IBM Plex Mono",ui-monospace,monospace}

    /* header */
    .firm .fh{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:50}
    .firm .fh-in{height:84px;display:flex;align-items:center;justify-content:space-between;gap:24px}
    .firm .fh-logo img{display:block;height:40px;width:auto}
    .firm .fh-nav{display:flex;align-items:center;gap:36px;margin-left:auto}
    .firm .fh-item{position:relative}
    .firm .fh-link{font-family:"IBM Plex Mono",monospace;font-size:16px;font-weight:500;color:var(--muted);background:none;border:0;padding:8px 0;cursor:pointer;text-decoration:none}
    .firm .fh-link:hover,.firm .fh-link.on{color:var(--navy)}
    .firm .fh-menu{display:none;position:absolute;top:calc(100% + 14px);left:-20px;width:340px;background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:0 18px 40px rgba(10,27,77,.12);padding:10px}
    .firm .fh-item > button[aria-expanded="true"] + .fh-menu{display:block}
    .firm .fh-menu a{display:block;padding:12px 14px;border-radius:10px;text-decoration:none}
    .firm .fh-menu a:hover{background:var(--soft)}
    .firm .fh-menu b{display:block;color:var(--navy);font-size:15px}
    .firm .fh-menu span{display:block;color:var(--muted);font-size:13px;line-height:1.45;margin-top:2px}
    .firm .fh-right{display:flex;align-items:center;gap:16px}
    .firm .fh-burger{display:none;background:none;border:0;color:var(--navy);cursor:pointer}

    /* buttons */
    .firm .pill{display:inline-block;font-family:"IBM Plex Mono",monospace;font-weight:600;font-size:15px;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;color:var(--navy);border:2px solid var(--navy);border-radius:999px;padding:9px 22px;background:#fff;transition:background .15s,color .15s}
    .firm .pill:hover{background:var(--navy);color:#fff}
    .firm .pill-blue{border-color:var(--blue);border-width:3px;padding:14px 30px;font-size:17px}
    .firm .pill-blue:hover{background:var(--blue);color:#fff}
    .firm .pill-sm{font-size:13px;padding:7px 16px}
    .firm .link{font-family:"IBM Plex Mono",monospace;font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:14px;color:var(--blue-deep);text-decoration:none}
    .firm .link:hover{text-decoration:underline}

    /* type */
    .firm .eyebrow{font-family:"IBM Plex Mono",monospace;font-size:14px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--blue-deep);margin:0 0 14px}
    .firm .display{font-weight:700;text-transform:uppercase;letter-spacing:.05em;line-height:1.08;color:var(--navy);margin:0}
    .firm .display.xl{font-size:clamp(40px,6vw,72px)}
    .firm .display.lg{font-size:clamp(30px,4vw,48px)}
    .firm .display.md{font-size:clamp(22px,2.4vw,30px)}
    .firm mark{background:none;color:inherit;position:relative;z-index:0;padding:0 .12em;white-space:normal}
    .firm mark::before{content:"";position:absolute;inset:.08em -.04em .02em;background:var(--hi);z-index:-1;transform:skew(-4deg) rotate(-.6deg);border-radius:2px}
    .firm .lede{font-size:clamp(18px,1.8vw,22px);color:var(--muted);max-width:760px;margin:22px 0 0}

    /* sections */
    .firm .hero{background:linear-gradient(160deg,#EEF4FF 0%,#F6F2FF 45%,#FFFFFF 100%);padding:120px 0 110px}
    .firm .hero .actions{margin-top:40px;display:flex;flex-wrap:wrap;gap:16px;align-items:center}
    .firm .band{padding:96px 0}
    .firm .band.soft{background:var(--soft)}
    .firm .band.navy{background:var(--navy);color:#fff}
    .firm .band.navy .display{color:#fff}
    .firm .band.navy .lede{color:#C9D3F0}
    .firm .band.navy .pill{border-color:#fff;color:#fff;background:transparent}
    .firm .band.navy .pill:hover{background:#fff;color:var(--navy)}
    .firm .head{margin-bottom:44px;max-width:820px}
    .firm .cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
    .firm .card{display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-radius:16px;padding:30px;text-decoration:none;transition:transform .15s,box-shadow .15s}
    .firm a.card:hover{transform:translateY(-3px);box-shadow:0 18px 40px rgba(10,27,77,.10)}
    .firm .card .eyebrow{margin-bottom:10px}
    .firm .card h3{font-size:24px;line-height:1.25;margin:0 0 12px;color:var(--navy)}
    .firm .card p{margin:0 0 22px;color:var(--muted)}
    .firm .card .link{margin-top:auto}
    .firm .steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:18px;counter-reset:s}
    .firm .steps li{counter-increment:s;border-top:3px solid var(--navy);padding-top:18px}
    .firm .steps li::before{content:"0" counter(s);display:block;font-family:"IBM Plex Mono",monospace;font-weight:600;color:var(--blue-deep);margin-bottom:8px}
    .firm .steps b{display:block;font-size:18px;margin-bottom:6px}
    .firm .steps span{color:var(--muted);font-size:15px}
    .firm .split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:64px;align-items:start}
    .firm .prose p{color:var(--muted);font-size:18px;margin:0 0 18px}
    .firm .ticks{list-style:none;margin:0;padding:0}
    .firm .ticks li{position:relative;padding:12px 0 12px 34px;border-bottom:1px solid var(--line);font-size:17px}
    .firm .ticks li::before{content:"";position:absolute;left:4px;top:21px;width:12px;height:12px;background:var(--hi);transform:rotate(45deg)}

    /* photos and graphics */
    .firm .hero{position:relative;overflow:hidden}
    .firm .hero::after{content:"";position:absolute;right:-120px;top:-120px;width:420px;height:420px;border-radius:50%;
      background:radial-gradient(circle,rgba(47,125,225,.16) 2px,transparent 2.5px) 0 0/18px 18px;pointer-events:none;z-index:0}
    .firm .hero > .fw{position:relative;z-index:1}
    .firm .hs-in{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.9fr);gap:64px;align-items:center}
    .firm .hero-split{padding:88px 0 96px}
    .firm .photo{position:relative;margin:0}
    .firm .photo img{display:block;width:100%;height:auto;aspect-ratio:9/10;object-fit:cover;border-radius:20px;position:relative;z-index:1;box-shadow:0 30px 60px rgba(10,27,77,.18)}
    .firm .photo::before{content:"";position:absolute;left:-22px;bottom:-22px;width:58%;height:46%;background:var(--hi);border-radius:16px;z-index:0}
    .firm .photo::after{content:"";position:absolute;right:-18px;top:-18px;width:120px;height:120px;border:3px solid var(--blue);border-radius:50%;z-index:2;pointer-events:none}
    .firm .photo.wide img{aspect-ratio:4/3}
    .firm .ic-chip{display:inline-grid;place-items:center;width:34px;height:34px;border-radius:10px;background:var(--hi);color:var(--navy);margin-right:12px;vertical-align:middle}
    .firm .ic-chip .ic{width:20px;height:20px}
    .firm .card-photo{padding:0;overflow:hidden}
    .firm .card-photo .cp-img{position:relative}
    .firm .card-photo .cp-img img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;transition:transform .4s}
    .firm a.card-photo:hover .cp-img img{transform:scale(1.04)}
    .firm .card-photo .cp-ic{position:absolute;left:24px;bottom:-22px;width:48px;height:48px;border-radius:14px;background:var(--hi);color:var(--navy);display:grid;place-items:center;box-shadow:0 8px 18px rgba(10,27,77,.18)}
    .firm .card-photo .cp-body{padding:38px 30px 30px;display:flex;flex-direction:column;flex:1}
    .firm .cards.two{grid-template-columns:repeat(2,minmax(0,1fr))}
    .firm .wave{display:block;width:100%;height:56px;color:var(--soft)}

    /* footer */
    .firm .ff{background:var(--navy);color:#C9D3F0;padding:72px 0 28px}
    .firm .ff-grid{display:grid;grid-template-columns:1.6fr repeat(4,1fr);gap:32px}
    /* Footer logo: all white, centres of the o and g in footer navy (inlined PNG made from kx-logo.png). */
    .firm .ff-logo{display:block;width:127px;height:32px}
    .firm .ff-brand .pill{display:inline-block;color:#fff}
    .firm .ff-brand p{font-size:15px;margin:16px 0 22px;max-width:340px}
    .firm .ff .pill{border-color:#fff;color:#fff;background:transparent}
    .firm .ff .pill:hover{background:#fff;color:var(--navy)}
    .firm .ff h4{font-family:"IBM Plex Mono",monospace;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#fff;margin:0 0 16px}
    .firm .ff-grid a{display:block;text-decoration:none;color:#C9D3F0;font-size:15px;margin-bottom:10px}
    .firm .ff-grid a:hover{color:#fff}
    .firm .ff-base{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;border-top:1px solid rgba(255,255,255,.14);margin-top:48px;padding-top:22px;font-size:14px}
    .firm .ff-base a{color:#C9D3F0;text-decoration:none;margin-left:20px}

    @media (max-width:980px){
      .firm .cards,.firm .cards.two{grid-template-columns:1fr}
      .firm .hs-in{grid-template-columns:1fr;gap:48px}
      .firm .photo{max-width:560px}
      .firm .photo img{aspect-ratio:4/3}
      .firm .photo::after{width:80px;height:80px;right:-8px;top:-12px}
      .firm .hero::after{display:none}
      .firm .steps{grid-template-columns:1fr 1fr}
      .firm .split{grid-template-columns:1fr;gap:28px}
      .firm .ff-grid{grid-template-columns:1fr 1fr}
      .firm .fh-burger{display:block}
      .firm .fh-nav{display:none;position:absolute;top:84px;left:0;right:0;background:#fff;border-bottom:1px solid var(--line);flex-direction:column;align-items:flex-start;gap:4px;padding:16px 32px}
      .firm .fh-nav.open{display:flex}
      .firm .fh-menu{position:static;width:auto;box-shadow:none;border:0;padding:0 0 0 8px}
      .firm .hero{padding:72px 0 64px}
      .firm .band{padding:64px 0}
    }
    .firm .fh-phone{display:none}
    @media (max-width:560px){.firm .fw{padding:0 20px}.firm .steps{grid-template-columns:1fr}.firm .fh-right .pill{display:none}.firm .fh-nav .fh-phone{display:block}}
  </style>
</body>
</html>
