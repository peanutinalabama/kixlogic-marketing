---
// Contact Us for the FlipbookIQ Library: questions about a flipbook, permission to use something, a problem to
// report, press. Sent to the Kixlogic team by email. This page is static; the form's script reads ?topic= and
// ?flipbook= from the address (the library's "contact us" links fill them in).
import Base from '../../../layouts/Base.astro';
import { LIBRARY_PATH, ORG_NAME, SITE, ldJson } from '../../../lib/library';

const API = 'https://flipbook.kixlogic.com/api/library/message';
const canonical = `${SITE}${LIBRARY_PATH}contact/`;
const topics = [
  ['question', 'A question about a flipbook'],
  ['permission', 'Permission to use or share something'],
  ['report', 'Report a problem or a concern'],
  ['press', 'Press or partnership'],
  ['other', 'Something else'],
];
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'ContactPage', name: 'Contact the FlipbookIQ Library', url: canonical, isPartOf: { '@type': 'CollectionPage', name: 'FlipbookIQ Library', url: `${SITE}${LIBRARY_PATH}` } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'FlipbookIQ', item: `${SITE}/flipbookiq/` },
      { '@type': 'ListItem', position: 2, name: 'Library', item: `${SITE}${LIBRARY_PATH}` },
      { '@type': 'ListItem', position: 3, name: 'Contact', item: canonical },
    ] },
    { '@type': 'Organization', name: ORG_NAME, url: `${SITE}/`, contactPoint: { '@type': 'ContactPoint', email: 'hello@kixlogic.com', contactType: 'customer support' } },
  ],
};
---
<Base
  title="Contact the FlipbookIQ Library"
  description="Ask a question about a flipbook, request permission to use something, report a problem, or get in touch about press and partnerships. Message the FlipbookIQ Library team at Kixlogic."
  canonical={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={ldJson(ld)} />
  </Fragment>

  <section class="hero-top">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/flipbookiq/">FlipbookIQ</a> <span aria-hidden="true">/</span> <a href={LIBRARY_PATH}>Library</a> <span aria-hidden="true">/</span> <span>Contact</span></nav>
      <h1>Contact the FlipbookIQ Library</h1>
      <p class="lede">A question about a flipbook, permission to use something, a problem to report, or an idea to share. Send us a message and we will reply by email.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap two">
      <div class="card">
        <form id="contact-form" data-api={API} novalidate>
          <p id="about" class="about" hidden></p>
          <label for="c-topic">What is it about?</label>
          <select id="c-topic" name="topic">
            {topics.map(([v, l]) => <option value={v}>{l}</option>)}
          </select>

          <div class="pair">
            <div>
              <label for="c-name">Your name</label>
              <input id="c-name" name="name" type="text" autocomplete="name" maxlength="100" required />
            </div>
            <div>
              <label for="c-company">Company <span class="opt">(optional)</span></label>
              <input id="c-company" name="company" type="text" autocomplete="organization" maxlength="120" />
            </div>
          </div>

          <label for="c-email">Email address</label>
          <input id="c-email" name="email" type="email" autocomplete="email" maxlength="200" required />

          <label for="c-message">Your message</label>
          <textarea id="c-message" name="message" rows="7" maxlength="3000" required></textarea>
          <p class="count"><span id="c-count">0</span> / 3000</p>

          <!-- A trap for simple bots: people never see or fill this. -->
          <div class="hp" aria-hidden="true"><label for="c-website">Website</label><input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>

          <p id="c-err" class="err" role="alert"></p>
          <button id="c-send" type="submit">Send message →</button>
          <p class="fine">We will use your details only to reply to you and to follow up about FlipbookIQ and Kixlogic. <a href="/privacy/">Privacy policy</a></p>
        </form>

        <div id="c-done" class="done" hidden role="status">
          <h2>Thank you. Your message is on its way.</h2>
          <p>We read every message and will reply to the email address you gave.</p>
          <p><a class="btn-p" href={LIBRARY_PATH}>Back to the library</a></p>
        </div>
      </div>

      <aside class="side">
        <h2>Prefer email?</h2>
        <p><a href="mailto:hello@kixlogic.com">hello@kixlogic.com</a></p>

        <h2>Asking permission</h2>
        <p>The flipbooks in the library are © {new Date().getUTCFullYear()} {ORG_NAME}. All rights reserved. Tell us what you would like to use, where, and for what, and we will get back to you.</p>

        <h2>Reporting a concern</h2>
        <p>If you believe something in a flipbook is yours, or is wrong, include the address of the flipbook's page and describe the part you mean.</p>

        <h2>Make your own</h2>
        <p>Want a flipbook like these? <a href="https://app.flipbookiq.com/studio?ref=library-contact">Start free in your browser</a>, or <a href="/flipbookiq/">read about FlipbookIQ</a>.</p>
      </aside>
    </div>
  </section>
</Base>

<script is:inline>
(function () {
  var form = document.getElementById('contact-form');
  if (!form) return;
  var err = document.getElementById('c-err');
  var send = document.getElementById('c-send');
  var msg = document.getElementById('c-message');
  var count = document.getElementById('c-count');
  var topic = document.getElementById('c-topic');
  var flipbook = '';

  // The library's "contact us" links say what the message is about and which flipbook.
  var q = new URLSearchParams(window.location.search);
  var t = q.get('topic');
  if (t) { for (var i = 0; i < topic.options.length; i++) { if (topic.options[i].value === t) topic.value = t; } }
  var f = q.get('flipbook');
  if (f && /^[a-z0-9-]{1,80}$/.test(f)) {
    flipbook = f;
    var about = document.getElementById('about');
    var a = document.createElement('a');
    a.href = '/flipbookiq/library/' + f + '/';
    a.textContent = '/flipbookiq/library/' + f + '/';
    about.appendChild(document.createTextNode('About this flipbook: '));
    about.appendChild(a);
    about.hidden = false;
  }

  msg.addEventListener('input', function () { count.textContent = String(msg.value.length); });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    err.textContent = '';
    var name = document.getElementById('c-name').value.trim();
    var email = document.getElementById('c-email').value.trim();
    var text = msg.value.trim();
    if (name.length < 2) { err.textContent = 'Please enter your name.'; document.getElementById('c-name').focus(); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { err.textContent = 'Please enter a valid email address.'; document.getElementById('c-email').focus(); return; }
    if (text.length < 10) { err.textContent = 'Please write a short message so we know how to help.'; msg.focus(); return; }
    send.disabled = true;
    send.textContent = 'Sending…';
    fetch(form.getAttribute('data-api'), {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        topic: topic.value, name: name, company: document.getElementById('c-company').value.trim(),
        email: email, message: text, flipbook: flipbook, website: document.getElementById('c-website').value,
      }),
    }).then(function (res) {
      return res.json().catch(function () { return {}; }).then(function (body) {
        if (!res.ok) throw new Error(body.error || 'That did not go through.');
        form.hidden = true;
        var done = document.getElementById('c-done');
        done.hidden = false;
        done.scrollIntoView({ block: 'center' });
      });
    }).catch(function (ex) {
      send.disabled = false;
      send.textContent = 'Send message →';
      err.textContent = (ex && ex.message && ex.message !== 'Failed to fetch') ? ex.message : 'We could not reach the server. Please try again, or email hello@kixlogic.com.';
    });
  });
})();
</script>

<style>
  .wrap { max-width: 1060px; margin: 0 auto; padding: 0 1.25rem; }
  .hero-top { background: #0b1220; color: #fff; padding: clamp(2.6rem, 7vw, 4.2rem) 0 clamp(1.8rem, 4vw, 2.6rem); }
  .crumbs { font-size: .85rem; color: #9fb3d8; margin-bottom: .9rem; }
  .crumbs a { color: #9fb3d8; }
  .hero-top h1 { font-size: clamp(2rem, 5vw, 2.9rem); line-height: 1.1; margin: 0 0 .8rem; }
  .lede { font-size: 1.1rem; line-height: 1.6; max-width: 44rem; color: #dbe4f3; }
  .band { padding: clamp(2rem, 5vw, 3.5rem) 0; background: #f3f6fb; color: #111; }
  .two { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 2rem; align-items: start; }
  @media (max-width: 800px) { .two { grid-template-columns: 1fr; } }
  .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 16px; padding: 1.6rem 1.5rem; box-shadow: 0 10px 30px rgba(15, 23, 42, .06); }
  label { display: block; font-size: .88rem; font-weight: 600; color: #374151; margin: .9rem 0 .3rem; }
  .opt { font-weight: 400; color: #6b7280; }
  input[type=text], input[type=email], select, textarea { width: 100%; box-sizing: border-box; padding: .7rem .8rem; font: inherit; font-size: 1rem; border: 1.5px solid #cbd5e1; border-radius: 10px; background: #fff; color: #111827; }
  textarea { resize: vertical; min-height: 9rem; }
  input:focus, select:focus, textarea:focus { outline: 3px solid #bfd3ff; border-color: #1d4ed8; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
  @media (max-width: 560px) { .pair { grid-template-columns: 1fr; } }
  .count { margin: .25rem 0 0; text-align: right; font-size: .78rem; color: #6b7280; }
  .about { margin: 0 0 .4rem; background: #eef3ff; border-radius: 10px; padding: .6rem .8rem; font-size: .92rem; color: #1e3a8a; word-break: break-all; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .err { min-height: 1.3em; margin: .8rem 0 0; color: #b42318; font-size: .92rem; font-weight: 600; }
  #c-send { width: 100%; margin-top: .4rem; padding: .9rem 1rem; font: inherit; font-size: 1.05rem; font-weight: 700; color: #fff; background: #1d4ed8; border: 0; border-radius: 999px; cursor: pointer; }
  #c-send:hover:not(:disabled) { background: #1a43b8; }
  #c-send:disabled { opacity: .7; cursor: default; }
  .fine { margin: .9rem 0 0; font-size: .8rem; line-height: 1.5; color: #6b7280; text-align: center; }
  .fine a { color: #1d4ed8; }
  .done { text-align: center; padding: 1.5rem .5rem; }
  .done h2 { margin: 0 0 .6rem; font-size: 1.5rem; }
  .done p { color: #4b5563; line-height: 1.6; }
  .btn-p { display: inline-block; background: #1d4ed8; color: #fff !important; text-decoration: none; padding: .75rem 1.3rem; border-radius: 999px; font-weight: 700; }
  .side h2 { font-size: 1.05rem; margin: 0 0 .35rem; color: #0b1220; }
  .side p { margin: 0 0 1.3rem; color: #374151; line-height: 1.6; font-size: .96rem; }
  .side a { color: #1d4ed8; font-weight: 600; }
</style>
