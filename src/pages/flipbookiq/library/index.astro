---
// The FlipbookIQ Library: flipbooks the Kixlogic team has chosen to show here. Rendered on the server from the
// FlipbookIQ service, so a flipbook added in the Studio appears within minutes without a rebuild.
export const prerender = false;

import Base from '../../../layouts/Base.astro';
import LibraryCard from '../../../components/LibraryCard.astro';
import LibraryGate from '../../../components/LibraryGate.astro';
import { CACHE, LIBRARY_PATH, ORG_NAME, SITE, STUDIO, entryPath, fetchLibrary, iso, ldJson, tagPath } from '../../../lib/library';

const { items, ok } = await fetchLibrary();
Astro.response.headers.set('Cache-Control', CACHE);

const tagCounts = new Map<string, number>();
for (const i of items) for (const t of i.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 24);

const canonical = `${SITE}${LIBRARY_PATH}`;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#page`,
      name: 'FlipbookIQ Library',
      description: 'Flipbooks made with FlipbookIQ, read online with a real page turn.',
      url: canonical,
      isPartOf: { '@type': 'WebSite', name: 'Kixlogic', url: `${SITE}/` },
      publisher: { '@type': 'Organization', name: ORG_NAME, url: `${SITE}/` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Kixlogic', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'FlipbookIQ', item: `${SITE}/flipbookiq/` },
        { '@type': 'ListItem', position: 3, name: 'Library', item: canonical },
      ],
    },
    ...(items.length
      ? [{
          '@type': 'ItemList',
          itemListElement: items.map((i, n) => ({ '@type': 'ListItem', position: n + 1, url: `${SITE}${entryPath(i.slug)}`, name: i.title, image: i.cover })),
        }]
      : []),
  ],
};
const newest = items[0]?.addedAt;
---
<Base
  title="FlipbookIQ Library — page-turning flipbooks to read and share"
  description="Browse flipbooks made with FlipbookIQ by Kixlogic: read each one online with a real page turn, share it, and see what you can make from a PDF, Word document or PowerPoint deck."
  canonical={canonical}
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="FlipbookIQ Library" href={`${LIBRARY_PATH}rss.xml`} />
    <script type="application/ld+json" set:html={ldJson(ld)} />
  </Fragment>

  <section class="hero-top">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/flipbookiq/">FlipbookIQ</a> <span aria-hidden="true">/</span> <span>Library</span></nav>
      <h1>FlipbookIQ Library</h1>
      <p class="lede">Flipbooks made with FlipbookIQ, read right here with a real page turn. Read them, share them, and see what you could make from your own PDF, Word document or PowerPoint deck.</p>
      <div class="ctas">
        <a class="btn-p" href={`${STUDIO}?ref=library`}>Make your own — free to start</a>
        <a class="btn-o" href="/flipbookiq/">About FlipbookIQ</a>
        <a class="btn-o" href="/flipbookiq/library/contact/">Contact us</a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      {tags.length > 0 && (
        <p class="tags" aria-label="Browse by topic">
          {tags.map(([t, n]) => (<a class="chip" href={tagPath(t)}>{t} <span>{n}</span></a>))}
        </p>
      )}

      {!ok && (
        <p class="note">The library could not be loaded just now. Please try again in a minute.</p>
      )}

      {ok && items.length === 0 && (
        <div class="empty">
          <h2>The first flipbooks are on their way</h2>
          <p>We are adding them now. In the meantime, you can make one of your own in a minute: drop in a PDF and share a page-turning flipbook with one link.</p>
          <p><a class="btn-p" href={`${STUDIO}?ref=library`}>Start free in your browser</a></p>
        </div>
      )}

      {items.length > 0 && (
        <>
          <h2 class="count">{items.length} {items.length === 1 ? 'flipbook' : 'flipbooks'}{newest && (<small> · newest added <time datetime={iso(newest)}>{new Date(newest * 1000).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time></small>)}</h2>
          <div class="grid">
            {items.map((i) => <LibraryCard item={i} />)}
          </div>
        </>
      )}
    </div>
  </section>

  <section class="band alt">
    <div class="wrap narrow">
      <h2>About these flipbooks</h2>
      <p>Every flipbook in the library is made with <a href="/flipbookiq/">FlipbookIQ</a>, the flipbook maker from Kixlogic. Each one is a real page turn you can read on a phone or a laptop, with the text of every page on its own page here so it can be found and searched.</p>
      <p class="rights"><strong>© {new Date().getUTCFullYear()} {ORG_NAME}. All rights reserved.</strong> You are welcome to read these flipbooks, link to them and share their pages. Copying, reposting or selling their contents is not allowed. For permission to use something, or to report a problem, <a href="/flipbookiq/library/contact/?topic=permission">contact us</a>.</p>
    </div>
  </section>

  {items.length > 0 && <LibraryGate />}
</Base>

<style>
  .wrap { max-width: 1060px; margin: 0 auto; padding: 0 1.25rem; }
  .narrow { max-width: 760px; }
  .hero-top { background: #0b1220; color: #fff; padding: clamp(3rem, 8vw, 5rem) 0 clamp(2rem, 5vw, 3rem); }
  .crumbs { font-size: .85rem; color: #9fb3d8; margin-bottom: .9rem; }
  .crumbs a { color: #9fb3d8; }
  .hero-top h1 { font-size: clamp(2.1rem, 5.5vw, 3.2rem); line-height: 1.08; margin: 0 0 .9rem; }
  .lede { font-size: 1.12rem; line-height: 1.6; max-width: 44rem; color: #dbe4f3; }
  .ctas { display: flex; gap: .75rem; flex-wrap: wrap; margin: 1.4rem 0 0; }
  .btn-p { display: inline-block; background: #1d4ed8; color: #fff; text-decoration: none; padding: .8rem 1.25rem; border-radius: 999px; font-weight: 700; }
  .btn-o { display: inline-block; border: 1px solid #7cc4ff; color: #fff; text-decoration: none; padding: .8rem 1.25rem; border-radius: 999px; font-weight: 600; }
  .band { padding: clamp(2rem, 5vw, 3.5rem) 0; background: #fff; color: #111; }
  .band.alt { background: #f3f6fb; }
  .band h2 { font-size: clamp(1.3rem, 3vw, 1.8rem); margin: 0 0 .8rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0 0 1.5rem; }
  .chip { background: #eef3ff; color: #1d4ed8; border-radius: 999px; padding: .3rem .85rem; text-decoration: none; font-weight: 600; font-size: .9rem; }
  .chip span { color: #6b7280; font-weight: 500; margin-left: .2rem; }
  .chip:hover { background: #dbe7ff; }
  .count { margin-bottom: 1.2rem !important; }
  .count small { font-size: .85rem; font-weight: 500; color: #6b7280; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.3rem; }
  .empty { text-align: center; padding: 2rem 1rem; }
  .note { background: #fff7ed; border: 1px solid #fdba74; border-radius: 10px; padding: .9rem 1.1rem; color: #7c2d12; }
  .band p { color: #374151; line-height: 1.65; }
  .rights { font-size: .92rem; color: #4b5563 !important; }
</style>
