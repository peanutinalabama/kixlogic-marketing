---
import Firm from '../../layouts/Firm.astro';
import { fetchPostings, postingPath, placeLine, SITE } from '../../lib/careers.js';

// Read from Kixlogic Command on each request (cached briefly), so a newly published role shows without a rebuild.
export const prerender = false;

let postings;
try {
  postings = await fetchPostings();
} catch {
  return new Response("Job listings are unavailable right now. Please check back soon.", { status: 503, headers: { "Retry-After": "600" } });
}
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: postings.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE}${postingPath(p)}`, name: p.title })),
};
---
<Firm
  title="Current Openings"
  description="Current openings at Kixlogic: direct-hire recruiting roles and HR consulting positions."
  canonical="https://kixlogic.com/careers/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
    <link rel="alternate" type="application/xml" title="Kixlogic jobs (Indeed XML feed)" href="https://kixlogic.com/careers/jobs.xml" />
    <link rel="alternate" type="application/xml" title="Kixlogic jobs (LinkedIn XML feed)" href="https://kixlogic.com/careers/linkedin.xml" />
  </Fragment>

  <section class="band">
    <div class="fw">
      <div class="head">
        <p class="eyebrow">Current openings</p>
        <h1 class="display xl">Open roles <mark>right now.</mark></h1>
        <p class="lede">These are the roles we are recruiting for now. Select a role to read the full description and apply.</p>
      </div>

      {postings.length === 0 ? (
        <p>There are no open roles right now. Check back soon.</p>
      ) : (
        <ul class="openings-list">
          {postings.map((p) => (
            <li>
              <a class="card" href={postingPath(p)}>
                <p class="eyebrow">{p.industry || 'Role'}</p>
                <h2>{p.title}</h2>
                <p>{placeLine(p)}{p.jobType ? ` · ${p.jobType}` : ''}</p>
                <span class="link">View role →</span>
              </a>
            </li>
          ))}
        </ul>
      )}
      <p style="margin-top:40px">Don't see a role that fits? <a class="link" href="/careers/talent-pool/">Join our talent pool</a> and send your resume anyway.</p>
    </div>
  </section>

  <style>
    .openings-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
    .openings-list a.card { display: block; height: 100%; text-decoration: none; color: inherit; }
    .openings-list h2 { margin: 0.25rem 0 0.5rem; font-size: 1.25rem; }
    @media (max-width: 980px) { .openings-list { grid-template-columns: 1fr; } }
  </style>
</Firm>
