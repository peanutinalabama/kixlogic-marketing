---
import Firm from '../../layouts/Firm.astro';
import { fetchPostings, postingPath, placeLine, jobPostingJsonLd, jobDescriptionHtml, plainPosting } from '../../lib/careers.js';

// One page per published role, read from Kixlogic Command on each request.
export const prerender = false;

let postings;
try {
  postings = await fetchPostings();
} catch {
  return new Response("Job listings are unavailable right now. Please check back soon.", { status: 503, headers: { "Retry-After": "600" } });
}
const p = postings.find((x) => String(x.id).toLowerCase() === String(Astro.params.id).toLowerCase());
if (!p) return new Response(null, { status: 404 });
const ld = jobPostingJsonLd(p);
const summary = plainPosting(p).slice(0, 155);
const pathUrl = `https://kixlogic.com${postingPath(p)}`;
---
<Firm
  title={`${p.title} · Current Openings`}
  description={summary || `${p.title}, ${placeLine(p)}. Read the role and apply.`}
  canonical={pathUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </Fragment>

  <section class="band">
    <div class="fw job-wrap">
      <p class="job-back"><a class="link" href="/careers/">← All current openings</a></p>
      <p class="eyebrow">{p.department || 'Role'}</p>
      <h1 class="display lg">{p.title}</h1>
      <p class="job-meta">
        {placeLine(p)}
        {p.jobType ? ` · ${p.jobType}` : ''}
      </p>
      {p.closeDate && <p class="job-meta">Apply by {p.closeDate}</p>}
      <div style="margin:28px 0 40px"><a class="pill pill-blue" href={p.applyUrl}>Apply for this role</a></div>

      <div class="job-body" set:html={jobDescriptionHtml(p)} />

      <p class="job-foot">Applications are reviewed by the Kixlogic recruiting team.</p>
    </div>
  </section>

  <style>
    .job-wrap { max-width: 820px; }
    .job-back { margin-bottom: 1.5rem; }
    .job-meta { color: var(--muted); margin: 0.2rem 0; }
    .job-body { line-height: 1.6; color: var(--ink); }
    .job-body :global(h2) { font-family: "IBM Plex Mono", monospace; font-size: 15px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--blue-deep); margin: 2rem 0 .6rem; }
    .job-foot { margin-top: 2.5rem; color: var(--muted); font-size: .95rem; }
  </style>
</Firm>
