---
import Firm from '../layouts/Firm.astro';
---
<Firm title="Contact" description="Talk to Kixlogic about a direct-hire search, HR consulting or an AI-enabled application. We reply to every message within one business day.">
  <section class="hero">
    <div class="fw">
      <p class="eyebrow">Contact us</p>
      <h1 class="display xl">Let's <mark>talk.</mark></h1>
      <p class="lede">Tell us about the role you need to fill, the HR problem in front of you, or the tool you want built. We reply within one business day.</p>
    </div>
  </section>

  <section class="band">
    <div class="fw split">
      <div class="prose">
        <p class="eyebrow">Email</p>
        <p><a class="link" style="font-size:16px" href="mailto:support@kixlogic.com">support@kixlogic.com</a></p>
        <p class="eyebrow" style="margin-top:32px">What helps us reply faster</p>
        <ul class="ticks">
          <li>For a search: the job title, location and pay range</li>
          <li>For HR consulting: what is getting in the way today</li>
          <li>For an application: the process you want to take off your team's plate</li>
        </ul>
      </div>
      <form class="cform" id="contactForm">
        <label>Your name<input id="contactName" name="name" type="text" required autocomplete="name" /></label>
        <label>Work email<input id="contactEmail" name="email" type="email" required autocomplete="email" /></label>
        <label>Company<input id="contactCompany" name="company" type="text" autocomplete="organization" /></label>
        <label>I'm interested in
          <select id="contactTopic" name="topic">
            <option>Direct hire recruiting</option>
            <option>HR consulting</option>
            <option>An AI-enabled application</option>
            <option>Something else</option>
          </select>
        </label>
        <label>Message<textarea id="contactMessage" name="message" rows="6" required></textarea></label>
        <button type="submit" class="pill pill-blue">Send message</button>
        <p id="contactMsg" class="cmsg" role="status"></p>
      </form>
    </div>
  </section>

  <script>
  document.getElementById('contactForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const msg = document.getElementById('contactMsg') as HTMLElement;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const v = (id: string) => ((document.getElementById(id) as HTMLInputElement | null)?.value || '').trim();
    const name = v('contactName'), email = v('contactEmail'), company = v('contactCompany'), topic = v('contactTopic');
    const message = v('contactMessage');
    if (!name || !email || !message) return;
    btn.disabled = true;
    btn.textContent = 'Sending…';
    msg.textContent = '';
    try {
      // The same endpoint the site has always used; the topic travels at the top of the message.
      const res = await fetch('https://api.kixlogic.com/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, company, message: `[${topic}]\n\n${message}`, subject: 'contact' }),
      });
      if (!res.ok) throw new Error();
      form.innerHTML = '<p class="cok">Thank you. Your message was sent and we will be in touch within one business day.</p>';
    } catch {
      btn.disabled = false;
      btn.textContent = 'Send message';
      msg.textContent = 'We could not send that just now. Please email support@kixlogic.com directly.';
    }
  });
  </script>

  <style is:global>
    .firm .cform{display:grid;gap:16px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:32px}
    .firm .cform label{display:grid;gap:6px;font-family:"IBM Plex Mono",monospace;font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--navy)}
    .firm .cform input,.firm .cform select,.firm .cform textarea{font:400 16px "IBM Plex Sans",sans-serif;letter-spacing:normal;text-transform:none;color:var(--ink);border:1px solid var(--line);border-radius:10px;padding:12px 14px;background:#fff}
    .firm .cform input:focus,.firm .cform select:focus,.firm .cform textarea:focus{outline:2px solid var(--blue);border-color:var(--blue)}
    .firm .cform button{justify-self:start;cursor:pointer}
    .firm .cmsg{color:#B42318;margin:0;min-height:1em}
    .firm .cok{font-size:18px;color:var(--navy);margin:0}
  </style>
</Firm>
