---
// One Kixlogic blog post, in the firm look. Only posts published since BLOG_SINCE are served;
// older ones go to the Insights page. ?preview=1 shows a draft from the Command Center.
export const prerender = false;
import Firm from '../../layouts/Firm.astro';
import { isCurrentPost } from '../../lib/blog-since';

const { slug } = Astro.params;
const preview = Astro.url.searchParams.get('preview') === '1';

let post: any;
try {
  const res = await fetch(`https://api.kixlogic.com/api/blog/posts/${slug}/public${preview ? '?preview=1' : ''}`);
  if (res.ok) post = (await res.json()).post;
} catch {}
if (!post || (!preview && !isCurrentPost(post))) return Astro.redirect('/blog/', 302);

const description = post.meta_description || post.excerpt || '';
const date = new Date(post.published_at || post.created_at || Date.now());
const dateStr = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const cover = post.cover_image_url || '';
const ld = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.meta_title || post.title, description,
  datePublished: date.toISOString(), author: { '@type': 'Person', name: post.author || 'Kixlogic Team' },
  publisher: { '@type': 'Organization', name: 'Kixlogic', logo: { '@type': 'ImageObject', url: 'https://kixlogic.com/kx-logo.png' } },
  ...(cover ? { image: cover } : {}),
};
---
<Firm title={post.meta_title || post.title} description={description} noindex={preview}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <section class="hero post-hero">
    <div class="fw post-w">
      <p class="eyebrow"><a href="/blog/" style="text-decoration:none">Insights</a>{(post.tags || []).slice(0, 2).map((t: string) => <span> · {t}</span>)}</p>
      <h1 class="display lg">{post.title}</h1>
      <p class="post-meta">{post.author || 'Kixlogic Team'} · <time datetime={date.toISOString()}>{dateStr}</time></p>
    </div>
  </section>
  <section class="band" style="padding-top:56px">
    <div class="fw post-w">
      {cover && <img class="post-cover" src={cover} alt="" />}
      <article class="post-body" set:html={post.content_html} />
      <div class="post-end"><a class="link" href="/blog/">← All insights</a><a class="pill pill-blue" href="/contact/">Talk to us</a></div>
    </div>
  </section>
  <style is:global>
    .firm .post-hero{padding:88px 0 64px}
    .firm .post-w{max-width:820px}
    .firm .post-meta{font-family:"IBM Plex Mono",monospace;font-size:14px;color:var(--muted);margin:24px 0 0}
    .firm .post-cover{display:block;width:100%;border-radius:16px;margin:0 0 40px}
    .firm .post-body{font-size:18px;color:#2A3555;line-height:1.75}
    .firm .post-body h2{font-size:28px;line-height:1.25;color:var(--navy);margin:44px 0 14px}
    .firm .post-body h3{font-size:22px;color:var(--navy);margin:32px 0 10px}
    .firm .post-body p,.firm .post-body ul,.firm .post-body ol{margin:0 0 20px}
    .firm .post-body a{color:var(--blue-deep)}
    .firm .post-body img{max-width:100%;height:auto;border-radius:12px}
    .firm .post-body blockquote{margin:28px 0;padding:4px 0 4px 22px;border-left:4px solid var(--hi);color:var(--navy)}
    .firm .post-end{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;border-top:1px solid var(--line);margin-top:48px;padding-top:28px}
  </style>
</Firm>
