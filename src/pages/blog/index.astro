---
// Insights (News & Notes) in the firm's look. Posts were taken off the site on 2026-11-12 at Charles's request:
// the old Kixlogic and FlipbookIQ posts are not listed or served here. Nothing was deleted; the posts still sit in
// the blog API and on FlipbookIQ's own blog.
export const prerender = false;
import Firm from '../../layouts/Firm.astro';
import { photoUrl } from '../../data/firm';
// Photo: free Unsplash licence, served from images.unsplash.com.
const heroPhoto = '1517048676732-d65bc937f952';
const topics = [
  ['Hiring', 'Finding and landing permanent talent in IT, engineering and the life sciences.'],
  ['HR practice', 'Practical HR for growing companies, from policies to compliance.'],
  ['Immigration', 'The HR side of work visas and green cards, explained plainly.'],
  ['AI at work', 'Where AI-enabled tools save HR and business teams real time.'],
];
---
<Firm title="Insights" description="News and notes from Kixlogic on hiring, HR practice, immigration and AI at work.">
  <section class="hero hero-split">
    <div class="fw hs-in">
      <div>
        <p class="eyebrow">Insights</p>
        <h1 class="display xl">News &amp; <mark>notes.</mark></h1>
        <p class="lede">From the Kixlogic team: what we are seeing in hiring, HR and immigration, and what we learn building AI-enabled tools.</p>
      </div>
      <figure class="photo">
        <img src={photoUrl(heroPhoto, 900, 1000)} alt="A team taking notes around a meeting table" width="900" height="1000" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="band">
    <div class="fw">
      <div class="head">
        <p class="eyebrow">Coming soon</p>
        <h2 class="display lg">New articles are <mark>on the way.</mark></h2>
        <p class="lede">We are writing our first pieces now. Here is what we will cover.</p>
      </div>
      <div class="cards topics">
        {topics.map(([t, d]) => (
          <div class="card"><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="band soft">
    <div class="fw">
      <h2 class="display lg">Have a question <mark>for us?</mark></h2>
      <p class="lede">Tell us what you would like us to write about, or what you need help with today.</p>
      <div style="margin-top:32px"><a class="pill pill-blue" href="/contact/">Contact us</a></div>
    </div>
  </section>

  <style is:global>
    .firm .cards.topics{grid-template-columns:repeat(4,minmax(0,1fr))}
    @media (max-width:980px){.firm .cards.topics{grid-template-columns:1fr}}
  </style>
</Firm>
