---
// Kixlogic the firm: home page. SSR, as before, so the route count stays the same.
export const prerender = false;
import Firm from '../layouts/Firm.astro';
import Icon from '../components/Icon.astro';
import { SERVICES, INDUSTRIES, photoUrl } from '../data/firm';
import { fetchPostings, postingPath, placeLine } from '../lib/careers.js';

// Open roles from Kixlogic Command. If the feed is unreachable, the section says so and the rest of the page still loads.
let openings = [];
let openingsOk = true;
try {
  openings = await fetchPostings();
} catch {
  openingsOk = false;
}

// Photos: free Unsplash licence, served from images.unsplash.com.
const heroPhoto = '1758691737543-09a1b2b715fa';
const whoPhoto = '1521791136064-7986c2920216';

const steps = [
  ['Intake', 'We agree the role, the must-haves, the pay range and the timeline.'],
  ['Search', 'We go beyond applicants to the people who are not actively looking.'],
  ['Screening', 'We interview every candidate before you see them.'],
  ['Shortlist', 'You get a short list of qualified people, with our reasons.'],
  ['Offer', 'We support interviews, references and the offer through to day one.'],
];
---
<Firm
  title="Kixlogic"
  description="Kixlogic is an HR services and consulting firm. We recruit direct-hire talent for IT, engineering and life science roles, support the HR side of work visas, and build AI-enabled HR applications that help SMBs do more with less."
>
  <section class="hero hero-split">
    <div class="fw hs-in">
      <div>
        <h1 class="display xl">We find the people who <mark>build what's next.</mark></h1>
        <p class="lede">Kixlogic is an HR services and consulting firm. We recruit permanent talent for IT, engineering and life science roles, help growing companies run HR well, support the HR side of work visas, and build AI-enabled HR applications that help SMBs do more with less.</p>
        <div class="actions">
          <a class="pill pill-blue" href="/contact/">Talk to us</a>
          <a class="link" href="/services/direct-hire-recruiting/">How we recruit →</a>
        </div>
      </div>
      <figure class="photo">
        <img src={photoUrl(heroPhoto, 900, 1000)} srcset={`${photoUrl(heroPhoto, 600, 667)} 600w, ${photoUrl(heroPhoto, 900, 1000)} 900w`} sizes="(max-width:980px) 100vw, 480px" alt="A team meeting around a table in a bright office" width="900" height="1000" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="band careers-band" id="current-openings">
    <div class="fw">
      <div class="head">
        <p class="eyebrow">Current openings</p>
        <h2 class="display lg">Open roles <mark>right now.</mark></h2>
      </div>
      {!openingsOk ? (
        <p>Our open roles are unavailable at the moment. Please check back soon.</p>
      ) : openings.length === 0 ? (
        <p>There are no open roles posted right now. New roles appear here as they open.</p>
      ) : (
        <ul class="openings-list">
          {openings.map((p) => (
            <li>
              <a class="card" href={postingPath(p)}>
                <p class="eyebrow">{p.department || 'Role'}</p>
                <h3>{p.title}</h3>
                <p>{placeLine(p)}{p.jobType ? ` · ${p.jobType}` : ''}</p>
                <span class="link">View role →</span>
              </a>
            </li>
          ))}
        </ul>
      )}
      <p style="margin-top:1.5rem"><a class="link" href="/careers/">See all current openings →</a></p>
    </div>
  </section>

  <section class="band">
    <div class="fw">
      <div class="head">
        <p class="eyebrow">Start with what you need</p>
        <h2 class="display lg">Four ways <mark>we help.</mark></h2>
      </div>
      <div class="cards two">
        {SERVICES.map((s) => (
          <a class="card card-photo" href={`/services/${s.slug}/`}>
            <div class="cp-img"><img src={photoUrl(s.photo, 720, 405)} alt={s.photoAlt} width="720" height="405" loading="lazy" /><span class="cp-ic"><Icon name={s.icon} /></span></div>
            <div class="cp-body">
              <p class="eyebrow">Services</p>
              <h3>{s.name}</h3>
              <p>{s.line}</p>
              <span class="link">Learn more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band soft">
    <div class="fw">
      <div class="head">
        <p class="eyebrow">Where we recruit</p>
        <h2 class="display lg">Specialists in <mark>three fields.</mark></h2>
        <p class="lede">We focus on the fields we know, so we can tell a strong candidate from a strong résumé.</p>
      </div>
      <div class="cards">
        {INDUSTRIES.map((s) => (
          <a class="card card-photo" href={`/industries/${s.slug}/`}>
            <div class="cp-img"><img src={photoUrl(s.photo, 600, 338)} alt={s.photoAlt} width="600" height="338" loading="lazy" /><span class="cp-ic"><Icon name={s.icon} /></span></div>
            <div class="cp-body">
              <p class="eyebrow">Industries</p>
              <h3>{s.name}</h3>
              <p>{s.line}</p>
              <span class="link">See the roles →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band navy">
    <div class="fw">
      <div class="head">
        <p class="eyebrow" style="color:#9FC3FF">Direct hire, on contingency</p>
        <h2 class="display lg">You pay only <mark style="color:#0A1B4D">when you hire.</mark></h2>
        <p class="lede">Every search follows the same five steps, so you always know where it stands.</p>
      </div>
      <ol class="steps" style="--navy:#ffffff">
        {steps.map(([t, d]) => <li><b>{t}</b><span style="color:#C9D3F0">{d}</span></li>)}
      </ol>
      <div style="margin-top:44px"><a class="pill" href="/contact/">Start a search</a></div>
    </div>
  </section>

  <section class="band">
    <div class="fw split" style="align-items:center">
      <figure class="photo wide" style="max-width:520px">
        <img src={photoUrl(whoPhoto, 800, 600)} alt="Two people shaking hands" width="800" height="600" loading="lazy" />
      </figure>
      <div class="prose">
        <p class="eyebrow">Who we are</p>
        <h2 class="display lg" style="margin-bottom:28px">HR people who <mark>build software.</mark></h2>
        <p>Kixlogic began by building HR and business software. We now put that experience to work for clients directly: recruiting the people they need, helping them run HR well, and building the tools that make it easier.</p>
        <p>That mix is the point. We understand the hiring and HR problems first-hand, and we can build the software that fixes the ones worth automating.</p>
        <a class="link" href="/about/">About Kixlogic →</a>
      </div>
    </div>
  </section>

  <section class="band soft">
    <div class="fw">
      <h2 class="display lg">Let's talk about <mark>your next hire.</mark></h2>
      <p class="lede">Tell us about the role, the HR problem or the tool you need. We reply to every message.</p>
      <div style="margin-top:32px"><a class="pill pill-blue" href="/contact/">Contact us</a></div>
    </div>
  </section>

  <style>
    .openings-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
    .openings-list a.card { display: block; height: 100%; text-decoration: none; color: inherit; }
    .openings-list h3 { margin: 0.25rem 0 0.5rem; }
    .careers-band { background: var(--hi); }
    .careers-band .eyebrow, .careers-band .link { color: var(--navy); }
    .careers-band .display, .careers-band p { color: var(--navy); }
    .careers-band mark { background: #fff; }
    .careers-band .card { background: #fff; }
    @media (max-width: 980px) { .openings-list { grid-template-columns: 1fr; } }
  </style>
</Firm>
