---
// SSR so homepage blog teaser reflects live CMS posts without a rebuild.
export const prerender = false;
import Base from '../layouts/Base.astro';
import HomepageSections from '../components/HomepageSections.astro';
import homepage from '../data/homepage.json';
---
<Base title={homepage.seo.title} description={homepage.seo.description} hidePromo={true}>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
  </Fragment>
  <HomepageSections />
</Base>
