---
// Kixlogic: home page. It is about one thing: AI web and app development, designed around each customer's need. Seekapedia is the last section.
// Recruiting, HR and the job openings live on their own pages (/services/ and /careers/), not here. SSR, as before, so the route count stays the same.
export const prerender = false;
import Firm from '../layouts/Firm.astro';
import Icon from '../components/Icon.astro';
import { CORE_SERVICES, photoUrl } from '../data/firm';
import { APPS } from '../data/apps';

// Photos: free Unsplash licence, served from images.unsplash.com.
const heroPhoto = '1607799279861-4dd421887fb3';
const whoPhoto = '1521791136064-7986c2920216';

const steps = [
  ['Listen', 'We learn how the work happens today and write the problem down in plain language.'],
  ['Design', 'You click through screens and flows before any code is written.'],
  ['Build', 'A working version early, tried on your real tasks and adjusted with you.'],
  ['Check', 'Anywhere AI drafts or decides, we design in the step where a person reviews it.'],
  ['Launch', 'We ship it and help your people get started. Ongoing support can be arranged if you want it.'],
];

const principles = [
  ['Design first', 'We show you the site or app before we build it, so you decide with something in front of you.'],
  ['Built to your need', 'No template to bend your process around. What we build follows the work you actually do.'],
  ['A person makes the call', 'AI drafts and flags. The decisions that matter stay with your people, by design.'],
  ['Yours to run', 'We build it so you can run it, and we talk through scope and price with you before work begins.'],
];

const kinds = [
  ['Websites and web apps', 'Sites and browser-based apps with AI built into the parts that save your team time.'],
  ['Microsoft Office add-ins', 'AI inside Word, Excel and PowerPoint, where your people already do the work.'],
  ['Mobile apps', 'Phone apps designed for the person using them, with AI behind the scenes.'],
  ['Assistants and automation', 'Assistants that read, draft and check documents, and automation that connects the tools you already use.'],
];

const questions = [
  'Is this company active, and in which state is it registered?',
  'Does it hold a liquor or cannabis license, and is it current?',
  'Is its name on an OFAC, UK or EU sanctions list?',
  'Has OSHA cited it for safety violations, or the EPA for environmental ones?',
  'What does it file with the SEC, and how big is its industry where it operates?',
];

const seekapedia = [
  ['Company records', 'State business registries, with one Seekapedia Business ID per company.'],
  ['Licenses', 'Liquor and cannabis licenses from state agencies, with a daily change feed.'],
  ['Risk and compliance', 'Sanctions screening, recalls, OSHA inspections and EPA records.'],
  ['Public companies', 'SEC filings, financials and identifiers, plus industry statistics by place.'],
];
---
<Firm
  title="Kixlogic"
  description="Kixlogic designs and builds AI apps and websites around how your business works: web apps, Microsoft Office add-ins and mobile apps. We also run Seekapedia, public business data in one API."
>
  <section class="hero hero-split">
    <div class="fw hs-in">
      <div>
        <p class="eyebrow">AI app and website development</p>
        <h1 class="display xl">We design and build AI apps and <mark>websites.</mark></h1>
        <p class="lede">Tell us the problem. Kixlogic designs the solution around how your business actually works, shows you the design first, then builds the AI-powered website or app: on the web, inside Microsoft Office or on a phone. Built to your need, and yours to run.</p>
        <div class="actions">
          <a class="pill pill-blue" href="/contact/">Start a project</a>
          <a class="link" href="/services/ai-applications/">How we build →</a>
        </div>
      </div>
      <figure class="photo">
        <img src={photoUrl(heroPhoto, 900, 1000)} srcset={`${photoUrl(heroPhoto, 600, 667)} 600w, ${photoUrl(heroPhoto, 900, 1000)} 900w`} sizes="(max-width:980px) 100vw, 480px" alt="A laptop screen showing application code" width="900" height="1000" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="band">
    <div class="fw">
      <div class="head">
        <p class="eyebrow">What we build</p>
        <h2 class="display lg">Sites, apps and automation <mark>made to order.</mark></h2>
        <p class="lede">Start with the process that is costing you time. We will tell you whether it needs a new app, a better site, or just a connection between the tools you have.</p>
      </div>
      <div class="cards two">
        {CORE_SERVICES.map((s) => (
          <a class="card card-photo" href={`/services/${s.slug}/`}>
            <div class="cp-img"><img src={photoUrl(s.photo, 720, 405)} alt={s.photoAlt} width="720" height="405" loading="lazy" /><span class="cp-ic"><Icon name={s.icon} /></span></div>
            <div class="cp-body">
              <p class="eyebrow">Build</p>
              <h3>{s.name}</h3>
              <p>{s.line}</p>
              <span class="link">Learn more →</span>
            </div>
          </a>
        ))}
      </div>
      <div class="cards two" style="margin-top:22px">
        {kinds.map(([t, d]) => (
          <div class="card"><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="band navy">
    <div class="fw">
      <div class="head">
        <p class="eyebrow" style="color:#9FC3FF">How a build works</p>
        <h2 class="display lg">Design comes <mark style="color:#0A1B4D">before code.</mark></h2>
        <p class="lede">Every project follows the same five steps, so you always know where it stands.</p>
      </div>
      <ol class="steps" style="--navy:#ffffff">
        {steps.map(([t, d]) => <li><b>{t}</b><span style="color:#C9D3F0">{d}</span></li>)}
      </ol>
      <div style="margin-top:44px"><a class="pill" href="/contact/">Describe your project</a></div>
    </div>
  </section>

  <section class="band">
    <div class="fw">
      <div class="head">
        <p class="eyebrow">How we work</p>
        <h2 class="display lg">Four things we hold <mark>to every time.</mark></h2>
      </div>
      <div class="cards">
        {principles.map(([t, d]) => (
          <div class="card"><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="band soft" id="apps">
    <div class="fw">
      <div class="head">
        <p class="eyebrow">Built and shipped</p>
        <h2 class="display lg">Apps we have built <mark>ourselves.</mark></h2>
        <p class="lede">We build our own products the way we build yours: on the web, inside Microsoft Office and on mobile.</p>
      </div>
      <div class="cards two">
        {APPS.map((a) => (
          <div class="card app-card">
            <p class="eyebrow"><span class="ic-chip"><Icon name={a.icon} size={20} /></span>{a.kind}</p>
            <h3>{a.name}</h3>
            <p>{a.line}</p>
            <div class="app-card-actions">
              <a class="pill" href="/contact/" aria-label={`Find Out More about ${a.name}`}>Find Out More</a>
              <a class="link" href={`/apps/#${a.slug}`} aria-label={`How ${a.name} works`}>How it works <span aria-hidden="true">→</span></a>
            </div>
          </div>
        ))}
      </div>
      <p style="margin-top:1.5rem"><a class="pill" href="/apps/">See all apps →</a></p>
    </div>
  </section>

  <section class="band">
    <div class="fw split" style="align-items:center">
      <figure class="photo wide" style="max-width:520px">
        <img src={photoUrl(whoPhoto, 800, 600)} alt="Two people shaking hands" width="800" height="600" loading="lazy" />
      </figure>
      <div class="prose">
        <p class="eyebrow">Who we are</p>
        <h2 class="display lg" style="margin-bottom:28px">A software company that <mark>knows the work.</mark></h2>
        <p>Kixlogic began by building business software. Building those products meant living inside the problems our users faced every day, and that is how we approach a customer's site or app: start with the work, design for the people doing it, and build only what earns its place.</p>
        <a class="link" href="/about/">About Kixlogic →</a>
      </div>
    </div>
  </section>

  <section class="band navy">
    <div class="fw">
      <h2 class="display lg">Have a process <mark style="color:#0A1B4D">worth fixing?</mark></h2>
      <p class="lede">Describe it in a few sentences. We reply to every message within one business day.</p>
      <div style="margin-top:32px"><a class="pill" href="/contact/">Start a project</a></div>
    </div>
  </section>

  <section class="band soft" id="seekapedia">
    <div class="fw">
      <div class="head">
        <p class="eyebrow">Seekapedia, a Kixlogic product</p>
        <h2 class="display lg">Public business data, <mark>in one API.</mark></h2>
        <p class="lede">Stop stitching together state websites and government downloads. Seekapedia brings public records on companies into one schema, each with its source and the date it was read: more than 20 million company records from 10 state registries, state license data, sanctions, safety and environmental records, and SEC filings.</p>
      </div>
      <div class="cards two">
        {seekapedia.map(([t, d]) => (
          <div class="card"><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
      <div class="split" style="margin-top:44px;align-items:start">
        <div><h3 class="display md">Ask it things like</h3></div>
        <div class="prose">
          <ul class="ticks">
            {questions.map((q) => <li>{q}</li>)}
          </ul>
          <p>Connect it to your own software with one API key, or to an AI assistant such as Claude or ChatGPT. There is a free plan to start with.</p>
        </div>
      </div>
      <div style="margin-top:36px;display:flex;flex-wrap:wrap;gap:14px 24px;align-items:center">
        <a class="pill pill-blue" href="https://seekapedia.com/request" rel="noopener">Get a free API key</a>
        <a class="pill" href="https://seekapedia.com/apis/registry/docs" rel="noopener">Read the docs</a>
        <a class="link" href="/seekapedia/">About Seekapedia →</a>
      </div>
    </div>
  </section>

  <style>
    .app-card-actions { margin-top: auto; display: flex; flex-wrap: wrap; gap: 12px 22px; align-items: center; }
    .app-card-actions .link { display: inline-block; padding: 12px 0; }
  </style>
</Firm>
