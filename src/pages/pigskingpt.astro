---
import Base from '../layouts/Base.astro';
import ProductPage from '../components/ProductPage.astro';
---
<Base
  title="PigskinGPT"
  description="PigskinGPT is Football Intelligence from Kixlogic — analysis and insight for the modern game."
>
  <ProductPage
    name="PigskinGPT"
    role="Football Intelligence"
    description="AI-powered football intelligence for fans, analysts, and operators who want sharper insight into the game."
    primaryCta={{ label: 'Visit PigskinGPT', href: 'https://pigskingpt.com/' }}
    secondaryCta={{ label: 'Talk to us', href: '/contact/' }}
    billboard={{
      ariaLabel: 'Football intelligence',
      line1: "There's film study.",
      line2Em: 'football intelligence.',
      chipFrom: 'Film study',
      chipTo: 'Football intelligence',
      sub: 'Game, film, and scouting AI built for the sport — sharper insight into the modern game.',
    }}
    points={[
      'Football-focused AI intelligence from the Kixlogic product family',
      'Built with the same craft standard as our workforce products',
      'Separate product experience at pigskingpt.com',
    ]}
  />
</Base>
