---
import Base from '../layouts/Base.astro';

const atsPlans = [
  {
    id: 'starter',
    name: 'Starter',
    price: '49',
    period: 'per month',
    desc: 'For a single recruiter or small team just getting started with structured hiring.',
    featured: false,
    cta: 'Get Started',
    ctaStyle: 'outline',
    features: [
      { ok: true, text: '2 active job postings' },
      { ok: true, text: '1 Admin + 1 Recruiter seat' },
      { ok: true, text: 'White-label careers page' },
      { ok: true, text: '8-stage kanban pipeline' },
      { ok: true, text: 'Search-engine job result eligible*' },
      { ok: true, text: 'Application auto-reply w/ merge tags' },
      { ok: true, text: 'Mobile-ready forms' },
      { ok: true, text: 'CSV export' },
      { ok: true, text: 'Applicant source tracking' },
      { ok: true, text: 'Talent community pool' },
      { ok: true, text: 'Advanced analytics dashboard' },
      { ok: true, text: 'Activity log audit trail' },
      { ok: true, text: 'Job cloning, reopen, close cascade' },
      { ok: true, text: 'Per-tenant SMTP (Yahoo/Gmail/O365)' },
      { ok: false, text: 'AI features' },
      { ok: false, text: 'Interview scheduling' },
      { ok: false, text: 'Employee referral portal' },
      { ok: false, text: 'Offer letters & onboarding' },
    ],
  },
  {
    id: 'growth',
    name: 'Growth',
    price: '129',
    period: 'per month',
    desc: 'For growing teams ready to layer AI and automation on top of their hiring process.',
    featured: false,
    cta: 'Start Free Trial',
    ctaStyle: 'outline',
    features: [
      { ok: true, text: '10 active job postings' },
      { ok: true, text: '1 Admin + 5 Recruiter seats' },
      { ok: true, text: 'Everything in Starter' },
      { ok: true, text: 'AI resume scoring (200/mo)', highlight: true },
      { ok: true, text: 'AI job description builder', highlight: true },
      { ok: true, text: 'AI resume search (natural language)', highlight: true },
      { ok: true, text: 'AI setup assistant in-dashboard', highlight: true },
      { ok: true, text: 'Rejection email workflow w/ reason codes', highlight: true },
      { ok: true, text: 'Welcome email template on hire', highlight: true },
      { ok: true, text: 'Forward to hiring manager', highlight: true },
      { ok: true, text: 'Employee referral portal', highlight: true },
      { ok: true, text: 'Interview scheduling + calendar invites', highlight: true },
      { ok: true, text: 'Talent community matching', highlight: true },
      { ok: true, text: 'Custom color schemes + advanced branding', highlight: true },
      { ok: false, text: 'Offer letters & e-signature' },
      { ok: false, text: 'Onboarding portal' },
    ],
  },
  {
    id: 'professional',
    name: 'Professional',
    price: '249',
    period: 'per month',
    desc: 'For established HR teams ready to automate the full employee lifecycle from offer through onboarding.',
    featured: true,
    badge: 'Most Popular',
    cta: 'Start Free Trial',
    ctaStyle: 'primary',
    features: [
      { ok: true, text: 'Unlimited job postings' },
      { ok: true, text: 'Unlimited seats' },
      { ok: true, text: 'Everything in Growth' },
      { ok: true, text: 'AI resume scoring (750/mo)', highlight: true },
      { ok: true, text: 'Applicant SMS texting (2,000/mo)', highlight: true },
      { ok: true, text: 'Offer letter templates, send & e-signature', highlight: true },
      { ok: true, text: 'Offer approval workflow (internal reviewer)', highlight: true },
      { ok: true, text: 'Candidate offer portal + e-signature', highlight: true },
      { ok: true, text: 'Onboarding packet builder (multi-doc)', highlight: true },
      { ok: true, text: 'Candidate onboarding portal + e-signature', highlight: true },
      { ok: true, text: 'Custom reports (build, save, run)', highlight: true },
      { ok: true, text: 'Scheduled CSV report delivery', highlight: true },
      { ok: true, text: 'AI Salary Intelligence (BLS + regional)', highlight: true },
      { ok: true, text: 'Per-applicant document library', highlight: true },
      { ok: true, text: 'XML job feeds for Indeed + aggregators', highlight: true },
      { ok: true, text: 'Priority support (24-hr response)', highlight: true },
      { ok: true, text: 'Renumify & Sourcer available as paid add-ons', highlight: true },
    ],
  },
  {
    id: 'enterprise',
    name: 'Enterprise',
    price: 'Custom',
    period: 'contact us',
    desc: 'For large organizations that need unlimited scale with dedicated support.',
    featured: false,
    customPrice: true,
    cta: 'Contact Sales',
    ctaStyle: 'outline',
    ctaHref: '/contact/',
    hideFeatures: true,
    features: [],
  },
];

const addonProducts = [
  {
    id: 'renumify',
    tab: 'cmp',
    name: 'Renumify',
    role: 'Compensation intelligence',
    desc: 'Market lookup, offer analysis, workforce compa-ratios, pay equity, and compression — sold as a monthly add-on to Kixlogic Hired.',
    features: [
      { ok: true, text: 'Market Lookup with role, location & skill premiums' },
      { ok: true, text: 'Offer Analyzer with competitiveness scoring' },
      { ok: true, text: 'Workforce, Pay Equity & Compression views' },
      { ok: true, text: 'Merit, bands & retention tooling' },
      { ok: true, text: 'Requires an active Hired account' },
      { ok: true, text: 'Checkout via Stripe inside Hired (Admin / Renumify hub)' },
    ],
  },
  {
    id: 'src',
    tab: 'src',
    name: 'Kixlogic Sourcer',
    role: 'AI candidate sourcing',
    desc: 'Natural-language search → ranked shortlists for any role. Monthly suite add-on plus optional usage packs for heavy AI volume.',
    features: [
      { ok: true, text: 'NL search with evidence-based ranking' },
      { ok: true, text: 'Quality gates & hard filters — not keyword spam' },
      { ok: true, text: 'Works across roles; scientific sources when needed' },
      { ok: true, text: 'Lite Chrome extension — save LinkedIn profiles you view into Sourced (separate from applicants)' },
      { ok: true, text: 'Usage-metered AI runs for high volume' },
      { ok: true, text: 'Requires an active Hired account' },
      { ok: true, text: 'Checkout via Stripe inside Hired (Sourcer hub)' },
    ],
  },
];

const atsFaqs = [
  {
    q: 'What happens after the 14-day trial?',
    a: "You'll choose a plan and enter your billing details. If you don't, your account pauses — your data is safe and you can reactivate anytime.",
  },
  {
    q: 'Can I switch plans later?',
    a: 'Yes, anytime. Upgrade from Starter to Growth or Professional via Admin → Billing (Stripe Customer Portal) — changes take effect immediately.',
  },
  {
    q: 'How do Renumify and Sourcer work?',
    a: 'Both are paid monthly add-ons to Kixlogic Hired. Start with a Hired plan below (Stripe Checkout), then unlock Renumify or Sourcer from the Hired dashboard — that also charges through Stripe.',
  },
  {
    q: 'Is my applicant data secure?',
    a: 'Yes. Data is encrypted in transit and at rest. Our web infrastructure is protected by Cloudflare, including DDoS mitigation, Web Application Firewall, and SSL/TLS attack protection.',
  },
  {
    q: 'Do I need to install any software?',
    a: 'No. Kixlogic is 100% cloud-based — sign up, configure your branding, and your careers page and Hired dashboard are live in under 10 minutes from any browser.',
  },
];

const addonFaqs = [
  {
    q: 'Can I buy Renumify or Sourcer without Hired?',
    a: 'Not today. Renumify and Sourcer unlock inside the Hired suite after you have an active account. Start with Hired checkout on this page, or sign in if you already subscribe.',
  },
  {
    q: 'How do I pay for an add-on?',
    a: 'Sign in to Hired → open Renumify or Sourcer. If the add-on is locked, choose Unlock add-on. That opens Stripe Checkout for the monthly add-on (and optional Sourcer usage packs).',
  },
  {
    q: 'Where do I manage billing later?',
    a: 'Admin → Billing opens the Stripe Customer Portal — update payment method, view invoices, or cancel. Plan changes for Hired also go through that portal.',
  },
];
---
<Base
  title="Pricing"
  description="Kixlogic Hired plans from $49/month, plus Renumify and Sourcer suite add-ons. Secure Stripe checkout. 14-day free trial on Growth and Professional."
>
  <section class="pricing-page section">
    <div class="container">
      <div class="pricing-header">
        <span class="tag">Simple, transparent pricing</span>
        <h1>Pay for what you need</h1>
        <p>
          <strong>Kixlogic Hired</strong> is the ATS hub — subscribe here via Stripe.
          <strong>Renumify</strong> and <strong>Sourcer</strong> are paid suite add-ons unlocked inside Hired (also Stripe).
        </p>
      </div>

      <div id="checkoutBanner" class="checkout-banner" hidden></div>

      <div class="pricing-tabs">
        <button class="pricing-tab active" data-tab="ats" type="button">Kixlogic Hired</button>
        <button class="pricing-tab" data-tab="cmp" type="button">Renumify</button>
        <button class="pricing-tab" data-tab="src" type="button">Kixlogic Sourcer</button>
      </div>

      <div class="pricing-tab-content active" id="ats-tab">
        <p class="pricing-tab-desc">Four plans for hiring teams of any size. Growth and Professional include a <strong>14-day free trial</strong>. Checkout is secured by Stripe.</p>
        <div class="pricing-grid">
          {atsPlans.map(plan => (
          <div class={`pricing-card card ${plan.featured ? 'featured' : ''}`}>
            {plan.badge && <div class="pricing-badge">{plan.badge}</div>}
            <div class="pricing-plan">{plan.name}</div>
            <div class={`pricing-price ${plan.customPrice ? 'custom' : ''}`}>
              {!plan.customPrice && <><sup>$</sup>{plan.price}<sup class="tax">†</sup></>}
              {plan.customPrice && plan.price}
            </div>
            <div class="pricing-period">
              {plan.period === 'contact us' ? (
                <>Contact <a href="/contact/" class="contact-link">Kixlogic</a> for a quote</>
              ) : (
                plan.period
              )}
            </div>
            <p class="pricing-desc">{plan.desc}</p>
            {!plan.hideFeatures && (
              <>
                <div class="pricing-divider"></div>
                <ul class="pricing-features">
                  {plan.features.map(f => (
                    <li class={`pricing-feature ${f.ok ? 'active' : ''} ${f.highlight ? 'highlight' : ''}`}>
                      <span class={f.ok ? 'check' : 'x'}>{f.ok ? '✓' : '✗'}</span>
                      {f.text}
                    </li>
                  ))}
                </ul>
              </>
            )}
            {plan.ctaHref ? (
              <a href={plan.ctaHref} class={`pricing-cta ${plan.ctaStyle === 'primary' ? 'pricing-cta-primary' : 'pricing-cta-outline'}`}>
                {plan.cta}
              </a>
            ) : (
              <button type="button" data-checkout={plan.id} class={`pricing-cta ${plan.ctaStyle === 'primary' ? 'pricing-cta-primary' : 'pricing-cta-outline'}`}>
                {plan.cta}
              </button>
            )}
          </div>
          ))}
        </div>

        <p class="pricing-note">
          Growth and Professional plans include a <span>14-day free trial</span>. Card required — cancel before trial ends and pay nothing. AI scoring overages billed at $0.15/application.
        </p>
      </div>

      {addonProducts.map(product => (
        <div class="pricing-tab-content" id={`${product.tab}-tab`}>
          <p class="pricing-tab-desc">{product.desc}</p>
          <div class="addon-layout">
            <div class="pricing-card card featured addon-card">
              <div class="pricing-badge">Suite add-on</div>
              <div class="pricing-plan">{product.name}</div>
              <div class="pricing-price custom">Monthly add-on</div>
              <div class="pricing-period">Billed through Stripe · requires Hired</div>
              <p class="pricing-desc">{product.role}</p>
              <div class="pricing-divider"></div>
              <ul class="pricing-features">
                {product.features.map(f => (
                  <li class={`pricing-feature ${f.ok ? 'active' : ''}`}>
                    <span class="check">✓</span>
                    {f.text}
                  </li>
                ))}
              </ul>
              <div class="addon-ctas">
                <button type="button" data-checkout="professional" class="pricing-cta pricing-cta-primary">
                  Start with Hired (Stripe)
                </button>
                <a href="https://app.kixlogic.com/dashboard" class="pricing-cta pricing-cta-outline">
                  Sign in to unlock add-on
                </a>
              </div>
            </div>
            <div class="addon-side">
              <h3>How purchase works</h3>
              <ol>
                <li>Subscribe to <strong>Kixlogic Hired</strong> on this page (Stripe Checkout).</li>
                <li>Sign in at <strong>app.kixlogic.com</strong>.</li>
                <li>Open <strong>{product.name}</strong> and choose <strong>Unlock add-on</strong> — Stripe Checkout again for the add-on.</li>
              </ol>
              <p class="addon-side-note">
                If Unlock add-on isn’t available yet for your tenant, contact us — we can enable Renumify or Sourcer and finish Stripe setup.
              </p>
              <a href="/contact/" class="contact-link">Talk to sales →</a>
            </div>
          </div>
        </div>
      ))}

      <p class="pricing-tax-note">
        <sup>†</sup> Hired prices shown are base subscription rates in U.S. dollars and do not include applicable taxes. Taxes calculated at Stripe checkout based on your billing address.
      </p>

      <div class="faq-wrap" id="ats-faq">
        <h2>Frequently asked</h2>
        {atsFaqs.map(f => (
          <details>
            <summary>{f.q}</summary>
            <div class="faq-body">{f.a}</div>
          </details>
        ))}
      </div>

      <div class="faq-wrap" id="cmp-faq" style="display: none;">
        <h2>Frequently asked</h2>
        {addonFaqs.map(f => (
          <details>
            <summary>{f.q}</summary>
            <div class="faq-body">{f.a}</div>
          </details>
        ))}
      </div>

      <div class="faq-wrap" id="src-faq" style="display: none;">
        <h2>Frequently asked</h2>
        {addonFaqs.map(f => (
          <details>
            <summary>{f.q}</summary>
            <div class="faq-body">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
.pricing-page { padding-top: 5rem; }
.pricing-header { text-align: center; margin-bottom: 3rem; }
.pricing-header .tag { margin-bottom: 1rem; }
.pricing-header h1 {
  font-family: var(--font-display);
  font-size: clamp(2rem, 5vw, 3.2rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  margin-bottom: 1rem;
}
.pricing-header p {
  font-size: 1.05rem;
  color: var(--text-muted);
  max-width: 640px;
  margin: 0 auto;
  line-height: 1.6;
}
.pricing-header strong { color: var(--ink); }

.checkout-banner {
  max-width: 720px;
  margin: 0 auto 1.5rem;
  padding: 0.85rem 1.25rem;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  background: var(--fog);
  color: var(--text);
  font-size: 0.9rem;
  text-align: center;
}
.checkout-banner.ok {
  border-color: rgba(20,184,148,0.35);
  background: rgba(20,184,148,0.08);
}
.checkout-banner.cancelled {
  border-color: var(--border);
}

.pricing-tabs {
  display: flex;
  gap: 1rem;
  justify-content: center;
  margin: 2rem 0 2.5rem;
  flex-wrap: wrap;
}
.pricing-tab {
  padding: 0.65rem 1.5rem;
  border-radius: var(--radius-pill);
  border: 1px solid var(--border);
  background: #fff;
  color: var(--text);
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition);
}
.pricing-tab:hover { border-color: var(--ms-blue); }
.pricing-tab.active {
  background: var(--ms-blue);
  color: #fff;
  border-color: var(--ms-blue);
}
.pricing-tab-content { display: none; }
.pricing-tab-content.active { display: block; }
.pricing-tab-desc {
  text-align: center;
  font-size: 0.95rem;
  color: var(--text-muted);
  margin-bottom: 2rem;
  max-width: 640px;
  margin-left: auto;
  margin-right: auto;
}

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-bottom: 2rem;
}
.pricing-card { position: relative; display: flex; flex-direction: column; padding: 1.5rem; }
.pricing-card.featured {
  border-color: var(--border-gold);
  background: linear-gradient(135deg, rgba(20,184,148,0.06), var(--surface));
  box-shadow: 0 0 60px rgba(20,184,148,0.1);
}
.pricing-badge {
  position: absolute;
  top: -13px; left: 50%; transform: translateX(-50%);
  background: var(--gold); color: var(--navy);
  padding: 0.25rem 1rem; border-radius: 99px;
  font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;
  white-space: nowrap;
}
.pricing-plan {
  font-family: var(--font-display); font-weight: 700; font-size: 0.875rem;
  text-transform: uppercase; letter-spacing: 2px; color: var(--text-muted); margin-bottom: 0.75rem;
}
.pricing-card.featured .pricing-plan { color: var(--gold); }
.pricing-price {
  font-family: var(--font-display); font-weight: 800; font-size: 3rem;
  color: var(--text); line-height: 1; margin-bottom: 0.25rem; letter-spacing: -2px;
}
.pricing-price.custom { font-size: 1.75rem; padding-top: 0.5rem; letter-spacing: -0.5px; }
.pricing-price sup { font-size: 1.5rem; vertical-align: super; }
.pricing-price.custom sup { font-size: 1rem; }
.pricing-price.sup.tax,
.pricing-price sup.tax { font-size: 0.5em; }
.pricing-period { font-size: 0.825rem; color: var(--text-muted); margin-bottom: 0.5rem; }
.pricing-period a.contact-link { color: var(--ms-blue); font-weight: 600; text-decoration: none; }
.pricing-period a.contact-link:hover { text-decoration: underline; }
.pricing-desc { font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.75rem; line-height: 1.5; }
.pricing-divider { height: 1px; background: var(--border); margin-bottom: 1.5rem; }
.pricing-features { list-style: none; display: flex; flex-direction: column; gap: 0.65rem; margin-bottom: 2rem; flex: 1; }
.pricing-feature { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.875rem; color: var(--text-dim); }
.pricing-feature.active { color: var(--text-muted); }
.pricing-feature.highlight { color: var(--gold); }
.pricing-feature .check { color: var(--gold); flex-shrink: 0; }
.pricing-feature .x { color: var(--text-dim); flex-shrink: 0; }
.pricing-cta {
  width: 100%; padding: 0.85rem; border-radius: 10px;
  font-weight: 700; font-size: 0.95rem; text-align: center;
  transition: var(--transition); display: block;
  border: none; cursor: pointer; font-family: inherit;
  text-decoration: none; box-sizing: border-box;
}
.pricing-cta-primary { background: var(--gold); color: var(--navy); }
.pricing-cta-primary:hover { background: var(--gold-light); box-shadow: 0 8px 25px rgba(20,184,148,0.3); }
.pricing-cta-outline { background: transparent; color: var(--text); border: 1.5px solid var(--border); }
.pricing-cta-outline:hover { border-color: var(--border-gold); background: var(--gold-dim); }

.addon-layout {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 1.5rem;
  align-items: start;
  max-width: 960px;
  margin: 0 auto 2rem;
}
.addon-card { max-width: none; }
.addon-ctas { display: flex; flex-direction: column; gap: 0.65rem; }
.addon-side {
  padding: 1.5rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--surface);
}
.addon-side h3 {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 700;
  margin: 0 0 1rem;
}
.addon-side ol {
  margin: 0 0 1.25rem;
  padding-left: 1.2rem;
  color: var(--text-muted);
  font-size: 0.9rem;
  line-height: 1.65;
}
.addon-side li { margin-bottom: 0.5rem; }
.addon-side-note {
  font-size: 0.8rem;
  color: var(--text-dim);
  line-height: 1.55;
  margin-bottom: 1rem;
}
.addon-side .contact-link {
  color: var(--ms-blue);
  font-weight: 700;
  font-size: 0.9rem;
  text-decoration: none;
}
.addon-side .contact-link:hover { text-decoration: underline; }

.pricing-note {
  text-align: center; margin-top: 2rem;
  font-size: 0.825rem; color: var(--text-dim);
  max-width: 800px; margin-left: auto; margin-right: auto; line-height: 1.7;
}
.pricing-note span { color: var(--gold); }
.pricing-tax-note {
  text-align: center; margin-top: 0.85rem;
  font-size: 0.75rem; color: var(--text-dim);
}

.faq-wrap { max-width: 760px; margin: 5rem auto 0; }
.faq-wrap h2 {
  font-family: var(--font-display); font-weight: 700; font-size: 1.5rem;
  text-align: center; margin-bottom: 2rem;
}
details {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); margin-bottom: 0.75rem; overflow: hidden;
}
details[open] { border-color: var(--border-gold); }
summary {
  padding: 1.1rem 1.4rem; cursor: pointer;
  font-weight: 600; font-size: 0.925rem; color: var(--text);
  list-style: none; display: flex; justify-content: space-between; align-items: center;
}
summary::-webkit-details-marker { display: none; }
summary::after { content: '+'; font-size: 1.4rem; color: var(--gold); font-weight: 300; }
details[open] summary::after { content: '−'; }
.faq-body { padding: 0 1.4rem 1.25rem; font-size: 0.875rem; color: var(--text-muted); line-height: 1.7; }

@media (max-width: 1024px) {
  .pricing-grid { grid-template-columns: repeat(2, 1fr); }
  .addon-layout { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .pricing-grid { grid-template-columns: 1fr; }
  .pricing-tabs { flex-direction: column; gap: 0.5rem; }
  .pricing-tab { width: 100%; }
}
</style>

<script>
document.querySelectorAll('.pricing-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    const tabName = tab.dataset.tab;

    document.querySelectorAll('.pricing-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.pricing-tab-content').forEach(c => c.classList.remove('active'));
    document.querySelectorAll('.faq-wrap').forEach(f => f.style.display = 'none');

    tab.classList.add('active');
    document.getElementById(tabName + '-tab').classList.add('active');
    const faq = document.getElementById(tabName + '-faq');
    if (faq) faq.style.display = 'block';
  });
});

(function showCheckoutBanner() {
  const params = new URLSearchParams(window.location.search);
  const status = params.get('checkout');
  const el = document.getElementById('checkoutBanner');
  if (!el || !status) return;
  el.hidden = false;
  if (status === 'success') {
    el.classList.add('ok');
    el.textContent = 'Payment received. Check your email for Hired setup instructions, then sign in at app.kixlogic.com.';
  } else if (status === 'cancelled') {
    el.classList.add('cancelled');
    el.textContent = 'Checkout cancelled — no charge. Pick a plan whenever you’re ready.';
  }
})();

(function openTabFromHash() {
  const hash = (window.location.hash || '').replace('#', '');
  if (hash === 'renumify' || hash === 'comp' || hash === 'cmp') {
    document.querySelector('.pricing-tab[data-tab="cmp"]')?.click();
  } else if (hash === 'sourcer' || hash === 'src') {
    document.querySelector('.pricing-tab[data-tab="src"]')?.click();
  }
})();
</script>
