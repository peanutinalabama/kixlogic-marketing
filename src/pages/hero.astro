---
import Base from '../layouts/Base.astro';

// Kixlogic Hero — the Excel add-in. House rules hold: no customer names,
// no invented numbers. Every count below is what the shipped build contains
// (39 rules, 45 utilities), and every promise is one the code keeps.

const INSTALL = 'https://hero.kixlogic.com/addin/install.html';
const BUY = {
  one: 'https://buy.stripe.com/fZueV6cXZ3TA8e92WQbMQ0y',
  five: 'https://buy.stripe.com/5kQeV6aPReye2TP9lebMQ0z',
  twentyFive: 'https://buy.stripe.com/cNi14g5vx0Ho7a5fJCbMQ0A',
};

const promises = [
  {
    title: 'Nothing leaves the building',
    body: 'The add-in reads the open workbook inside Excel and writes only to it. The pane is a static bundle served from one origin; there is no fetch, no upload, no telemetry, no model. A firm’s IT can host the bundle on its own intranet.',
  },
  {
    title: 'Every finding is explainable',
    body: 'Each of the 39 rules is a fixed procedure with a plain-English definition. The audit memo reproduces those definitions verbatim, so when an auditor asks what was checked, the answer is already written down.',
  },
  {
    title: 'An audit trail that travels with the file',
    body: 'Dispositions — no action, corrected, accepted — are written to a review sheet inside the workbook, with reviewer and date. The memo becomes a worksheet. If a finding changes after it was reviewed, the tool says so.',
  },
];

const powers = [
  {
    name: 'Close the books',
    body: 'For the month-end, quarter-end and year-end close: trial balance footing, SUM ranges that miss a row, hardcodes inside formula columns, formulas that break their column’s pattern, error values with their cause, external links, numbers and dates stored as text, tie-outs that do not tie, journal entries out of balance or unapproved, suspense and plug balances, checklists marked complete over open notes, reversed thresholds, sign errors in statement links, stale reconciling items, duplicate vendors and shared bank details, records missing from their master, dates that contradict, unit-of-measure differences, stale extracts.',
  },
  {
    name: 'Payroll register',
    body: 'For the register you sign off before payroll funds: cross-foot — hours, gross, every subtotal, net — classified from the workbook’s own GL code mapping; hours against the stated pay period; a full period of leave paid on top of a full period worked; pay after termination; rate and bank details against the employee master; FICA and Medicare at the statutory rates on the right wages; garnishments under the federal cap; check numbers; labor distribution; overtime to exempt staff; negative deductions; unmapped codes; mid-period proration; active employees left off the register; the GL cash offset; an ADP batch file if the workbook holds one.',
  },
];

const menus = [
  { name: 'Fix', items: 'Convert numbers stored as text · convert dates stored as text · break links to other workbooks · highlight typed values inside formula ranges · select error cells · highlight duplicate rows' },
  { name: 'Reconcile', items: 'Match two lists · compare two sheets · summarize by a column · list unique values with counts' },
  { name: 'Audit', items: 'List every formula · find fragile formulas · draw a random sample (seed recorded) · Benford first-digit test · add aging buckets' },
  { name: 'HR', items: 'Split by manager · workforce profile' },
  { name: 'Text', items: 'Trim and clean · UPPER · lower · Proper · fill blanks from above' },
  { name: 'Sheets', items: 'Unhide everything · sheet index · sort sheets · freeze at selection · unfreeze all' },
  { name: 'Formulas', items: 'Formulas to values · select formulas · typed values · blanks' },
  { name: 'Columns', items: 'Split by delimiter · combine · delete blank columns · autofit · swap two columns · number a column · transpose' },
  { name: 'Rows', items: 'Delete blank rows · delete rows blank in a column · delete hidden rows · delete duplicates · insert a row every N · shade alternate rows · reverse order' },
];

// Screenshots live in src/assets/shots. A missing file is skipped at build
// time rather than shipping a broken image, so this list can name shots that
// do not exist yet.
const SHOTS = [
  {
    file: 'ribbon.png',
    alt: 'The Kixlogic Hero tab on the Excel ribbon, with its menus open',
    title: 'Its own tab, the way a utilities add-in should be',
    body: 'Two checkers on the left, then nine menus. Everything is one click from the ribbon, and nothing is buried in a dialog.',
  },
  {
    file: 'findings.png',
    alt: 'The Kixlogic Hero pane listing findings beside a reconciliation sheet in Excel',
    title: 'Every finding names the cell and the reason',
    body: 'Click one and Excel selects the offending cell. Each card quotes the formula and states what should have been true, in a sentence you can put in a workpaper.',
  },
  {
    file: 'disposition.png',
    alt: 'A finding being marked with a disposition and a note',
    title: 'Your review is written into the workbook',
    body: 'No action, corrected or accepted, with your name and the date, on a sheet that travels with the file. Re-check it next month and the tool tells you if a reviewed finding has changed.',
  },
  {
    file: 'split-by-manager.png',
    alt: 'One worksheet per manager, produced by the Split by manager utility',
    title: 'One tab per manager, in a second',
    body: 'Merit review season: each manager gets their direct reports and everyone beneath them, with the reporting level. Hand each one only their own people.',
  },
];

const files = import.meta.glob<string>('../assets/shots/*.png', { eager: true, query: '?url', import: 'default' });
const urlOf = new Map(Object.entries(files).map(([path, url]) => [path.split('/').pop()!, url]));
const shots = SHOTS.flatMap((s) => {
  const src = urlOf.get(s.file);
  return src ? [{ ...s, src }] : [];
});

const plans = [
  { name: '1 seat', price: '$149', per: 'one person, for life', href: BUY.one },
  { name: '5 seats', price: '$599', per: '$120 a seat, for life', href: BUY.five, featured: true },
  { name: '25 seats', price: '$2,490', per: 'under $100 a seat, for life', href: BUY.twentyFive },
];

const faq = [
  { q: 'What does the 90-day trial include?', a: 'Everything. The trial is the full product for 90 days from first use, counted on your computer. When it ends the pane still opens and everything already written into your workbooks stays readable; running a check or a utility asks for a key.' },
  { q: 'What does “for life” mean?', a: 'You pay once. The key never expires and is checked on your computer against a public key built into the add-in — no server, no renewal, no account.' },
  { q: 'How are seats counted?', a: 'Each computer shows an Install ID in the Hero pane. Your purchase certificate is exchanged, on our activation page, for a seat key bound to that Install ID — one per computer, up to the seats you bought. Replacing a computer? Release its Install ID and the seat is free again. The add-in itself never makes a network call; the exchange happens in your browser and carries nothing about your workbooks.' },
  { q: 'Which Excel?', a: 'Excel for Microsoft 365 on Windows and Mac, and Excel on the web. Excel 2019 and 2021 load the pane from Insert ▸ My Add-ins without the ribbon tab.' },
  { q: 'Can our IT department deploy it?', a: 'Yes — from the Microsoft 365 admin center, from a shared folder, or by hosting the static bundle on your own intranet. The install page has the steps.' },
  { q: 'Refunds?', a: 'The 90-day free trial is the refund window: try everything, buy only when it has earned it. Purchases are final, with one exception — a mistaken purchase (bought twice, or the wrong seat pack) is refunded on request within 7 days. Email support@kixlogic.com with your receipt.' },
];
---
<Base
  title="Kixlogic Hero — the Excel add-in for accounting and payroll"
  description="Checks the spreadsheets behind a month-end close or a payroll run, and explains every problem in plain English. 39 deterministic rules, 45 utilities, nothing leaves the machine. One-time purchase, 90-day free trial."
>
  <section class="hero-top">
    <div class="wrap">
      <div class="head">
        <img class="mark" src="/apps/hero.png" alt="" width="320" height="320" />
        <div>
          <p class="kicker">Kixlogic · Excel add-in</p>
          <h1>Kixlogic Hero<br /><em>Your Excel superpower.</em></h1>
        </div>
      </div>
      <p class="lede">
        It is the night before the numbers are due. Open the workbook you are closing the month with —
        or the payroll register you are about to approve — and Kixlogic Hero reads every sheet and tells you
        what is wrong: the total that does not foot, the formula someone typed over, the employee paid after
        they left. Each one explained in a sentence an auditor would accept, and the fix is one click away.
        It runs on your computer. Nothing is sent anywhere.
      </p>
      <div class="ctas">
        <a class="btn-p" href={INSTALL}>Start the 90-day free trial</a>
        <a class="btn-o" href="#pricing">See pricing</a>
      </div>
      <p class="fine">No account, no card, no upload. Install and check a workbook in two minutes.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Three things a CPA insisted on</h2>
      <div class="cards3">
        {promises.map((p) => (
          <div class="card"><h3>{p.title}</h3><p>{p.body}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap">
      <h2>Two powers</h2>
      <div class="powers">
        {powers.map((p) => (
          <div class="power"><h3>{p.name}</h3><p>{p.body}</p></div>
        ))}
      </div>
      <p class="note">Every finding names the cell, states the rule that fired, and — where the formula shows it — the cause: “divides by B37, which is 0 (='Payroll Register'!V35; V35 is empty)”.</p>
    </div>
  </section>

  {shots.length > 0 && (
    <section class="band">
      <div class="wrap">
        <h2>What it looks like</h2>
        <p class="sub">Real screens from a month-end close workbook, not a mock-up.</p>
        <div class="shots">
          {shots.map((s) => (
            <figure class="shot">
              <a href={s.src} target="_blank" rel="noopener">
                <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
              </a>
              <figcaption>
                <b>{s.title}</b>
                <span>{s.body}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="band">
    <div class="wrap">
      <h2>45 utilities on one ribbon tab</h2>
      <p class="sub">The first six fix what the checker finds. The rest are the ones accountants open a utilities add-in for every day.</p>
      <div class="menus">
        {menus.map((m) => (
          <div class="menu"><b>{m.name} ▾</b><span>{m.items}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="band alt" id="pricing">
    <div class="wrap">
      <h2>One price. Yours for life.</h2>
      <p class="sub">Try everything free for 90 days. Buy once when it has earned it — the trial is the refund window.</p>
      <div class="plans">
        {plans.map((p) => (
          <div class={`plan ${p.featured ? 'featured' : ''}`}>
            <div class="plan-name">{p.name}</div>
            <div class="plan-price">{p.price}</div>
            <div class="plan-per">{p.per}</div>
            <a class="btn-p" href={p.href}>Buy {p.name}</a>
          </div>
        ))}
      </div>
      <p class="fine">More seats, or a site license for a firm? <a href="/contact/">Ask us</a>. Your purchase certificate appears on the page after checkout (and again from the receipt link); seat keys are made per computer on the activation page. <a href="/hero-terms/">License terms, privacy and refunds</a>.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Questions</h2>
      <div class="faq">
        {faq.map((f) => (
          <details><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
      <p class="fine"><a href={INSTALL}>Install Kixlogic Hero</a> · <a href="/hero-terms/">Terms</a> · <a href="mailto:support@kixlogic.com">support@kixlogic.com</a></p>
    </div>
  </section>
</Base>

<style>
  .wrap { max-width: 980px; margin: 0 auto; padding: 0 1.25rem; }
  .hero-top { background: #0b1220; color: #fff; padding: clamp(3.5rem, 9vw, 6rem) 0 clamp(2.5rem, 6vw, 4rem); }
  .kicker { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: #9fb3d8; margin-bottom: 0.75rem; }
  .head { display: flex; align-items: center; gap: clamp(1rem, 3vw, 1.75rem); margin-bottom: 1rem; }
  .head .kicker { margin-bottom: 0.5rem; }
  .head h1 { margin: 0; }
  .mark { width: clamp(64px, 10vw, 104px); height: auto; flex: none; border-radius: 23%; box-shadow: 0 12px 34px rgba(0, 0, 0, 0.5); }
  .hero-top h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); line-height: 1.05; margin: 0 0 1rem; }
  .hero-top h1 em { font-style: normal; color: #7cc4ff; }
  .lede { font-size: 1.15rem; line-height: 1.6; max-width: 46rem; color: #dbe4f3; }
  .ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 1.5rem 0 0.75rem; }
  .btn-p { display: inline-block; background: #1d4ed8; color: #fff; text-decoration: none; padding: 0.8rem 1.25rem; border-radius: 999px; font-weight: 700; }
  .btn-o { display: inline-block; border: 1px solid #7cc4ff; color: #fff; text-decoration: none; padding: 0.8rem 1.25rem; border-radius: 999px; font-weight: 600; }
  .fine { font-size: 0.85rem; color: #9fb3d8; }
  .band { padding: clamp(2.5rem, 6vw, 4rem) 0; background: #fff; color: #111; }
  .band.alt { background: #f3f6fb; }
  .band h2 { font-size: clamp(1.5rem, 3.5vw, 2.1rem); margin: 0 0 0.75rem; }
  .band .fine { color: #4b5563; margin-top: 1.25rem; }
  .sub { color: #4b5563; max-width: 44rem; margin-bottom: 1.5rem; }
  .cards3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
  .card { border: 1px solid #e5e7eb; border-top: 3px solid #1d4ed8; border-radius: 10px; padding: 1.1rem 1.2rem; background: #fff; }
  .card h3, .power h3 { font-size: 1.05rem; margin: 0 0 0.5rem; }
  .card p, .power p, .note { color: #374151; line-height: 1.6; font-size: 0.97rem; }
  .powers { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; }
  .power { background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 1.1rem 1.2rem; }
  .note { margin-top: 1.25rem; font-style: italic; }
  .shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.6rem; }
  .shot { margin: 0; }
  .shot img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    box-shadow: 0 8px 28px rgba(15, 23, 42, 0.1);
    background: #fff;
  }
  .shot figcaption { margin-top: 0.7rem; font-size: 0.95rem; line-height: 1.55; }
  .shot figcaption b { display: block; color: #111; margin-bottom: 0.15rem; }
  .shot figcaption span { color: #4b5563; }
  .menus { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 0.6rem 1.25rem; }
  .menu { padding: 0.6rem 0; border-bottom: 1px solid #e5e7eb; font-size: 0.95rem; line-height: 1.5; }
  .menu b { display: block; color: #1d4ed8; margin-bottom: 0.15rem; }
  .menu span { color: #374151; }
  .plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
  .plan { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 1.4rem 1.2rem; text-align: center; }
  .plan.featured { border-color: #1d4ed8; box-shadow: 0 6px 24px rgba(29, 78, 216, 0.12); }
  .plan-name { font-weight: 700; color: #1d4ed8; letter-spacing: 0.04em; text-transform: uppercase; font-size: 0.8rem; }
  .plan-price { font-size: 2.4rem; font-weight: 800; margin: 0.35rem 0 0.1rem; }
  .plan-per { color: #6b7280; margin-bottom: 1rem; }
  .faq details { border-bottom: 1px solid #e5e7eb; padding: 0.7rem 0; }
  .faq summary { cursor: pointer; font-weight: 600; }
  .faq p { color: #374151; line-height: 1.6; margin: 0.5rem 0 0; }
</style>
