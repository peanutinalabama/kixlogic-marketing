---
import BlogTeaser from './BlogTeaser.astro';

// Every capability cites a system that is actually in production. The fastest
// way for a small company to look like a fake big one is invented numbers and
// stock-photo teams; the proof here is running software people can click into.
const capabilities = [
  {
    title: 'AI Agents & Automation',
    body: 'Autonomous agents that search, enrich, rank, and act — multi-step workflows with evidence attached to every decision, not keyword matching with a chat window on top.',
    proof: 'In production: Sourcer, an AI sourcing agent that turns a plain-language brief into a ranked, evidenced candidate shortlist.',
  },
  {
    title: 'LLM Product Engineering',
    body: 'Frontier models engineered into real product loops — structured outputs, guardrails, fallbacks, cost ceilings, and observability. The model is a component, never the architecture.',
    proof: 'In production: Auralis, an AI language teacher whose every spoken turn is a governed model call with an offline fallback.',
  },
  {
    title: 'Applied Speech & Language',
    body: 'On-device speech recognition and synthesis fused with cloud reasoning — real-time spoken interfaces that stay private, fast, and affordable at scale.',
    proof: 'In production: live spoken lessons across five languages, evaluated on eleven skill dimensions per turn.',
  },
  {
    title: 'Intelligent Document & Identity Processing',
    body: 'Extraction, scoring, and authenticity analysis over the documents businesses actually run on — résumés, IDs, job posts — with decisions a human can audit.',
    proof: 'In production: AI résumé scoring in Kixlogic Hired; barcode-and-AI ID authenticity analysis in Venue.',
  },
  {
    title: 'Data Pipelines & Enrichment',
    body: 'Crawling, normalization, structured-data generation, and syndication pipelines that keep AI systems grounded in fresh, well-governed data.',
    proof: 'In production: ScientificGigs enriches and syndicates 2,400+ life-science roles with validated structured data.',
  },
  {
    title: 'Full-Stack Delivery on Edge Infrastructure',
    body: 'From strategy to shipped: serverless edge compute, managed Postgres, payments, and CI that proves every change before it lands. Small surface area, enterprise discipline.',
    proof: 'In production: every Kixlogic platform runs on this stack — global edge deploys measured in seconds, not sprints.',
  },
];

const platforms = [
  {
    name: 'Kixlogic Hired + Sourcer',
    tag: 'Talent Intelligence',
    line: 'Applicant tracking with AI résumé scoring, plus an autonomous sourcing agent that builds ranked shortlists from a sentence.',
    href: '/hired/',
    live: true,
  },
  {
    name: 'Renumify',
    tag: 'Compensation Intelligence',
    line: 'Market ranges, offer scoring, equity, and compression analysis — pay decisions with evidence behind them.',
    href: '/renumify/',
    live: true,
  },
  {
    name: 'ScientificGigs',
    tag: 'Life-Science Hiring',
    line: 'The most cost-effective life-science job board — AI-enriched listings, Google Jobs syndication, sourcing credits.',
    href: '/scientificgigs/',
    live: true,
  },
  {
    name: 'Venue by Kixlogic',
    tag: 'Identity Intelligence',
    line: 'Hardware-neutral ID scanning and AI authenticity analysis for venues — compliance without PII retention.',
    href: '/venue/',
    live: true,
  },
  {
    name: 'LilyFi',
    tag: 'Voice Budgeting',
    line: 'Envelope budgeting you can talk to — say what you spent, Lily logs it and speaks it back. No bank logins.',
    href: '/lilyfi/',
    live: true,
  },
  {
    name: 'Auravo',
    tag: 'AI Language Coach',
    line: 'A spoken AI coach that adapts every turn to how you actually learn. Speaking-first from minute one.',
    href: '/auravo/',
    live: false,
    status: 'Coming to the App Store',
  },
];

const process_ = [
  {
    n: '01',
    title: 'Discover',
    body: 'Identify where intelligence changes the economics — the workflow, the data, the decision worth automating. No AI for AI’s sake.',
  },
  {
    n: '02',
    title: 'Prototype',
    body: 'A working system against real data in days. Prompts, pipelines, and product loops proven before anything is scaled.',
  },
  {
    n: '03',
    title: 'Production',
    body: 'Guardrails, fallbacks, cost ceilings, CI verification, and observability. AI that fails safe and bills predictably.',
  },
  {
    n: '04',
    title: 'Operate',
    body: 'Live systems watched, measured, and improved — model routing, token economics, and quality tracked per feature.',
  },
];

const stack = [
  'Anthropic Claude', 'Cloudflare Workers', 'Supabase Postgres',
  'Stripe', 'SwiftUI', 'Astro', 'Durable edge CI',
];
---

<!-- Hero -->
<section class="ai-hero" aria-label="Kixlogic — AI intelligence company">
  <div class="ai-hero-glow" aria-hidden="true"></div>
  <div class="ai-hero-grid" aria-hidden="true"></div>
  <div class="container ai-hero-inner">
    <p class="ai-eyebrow">Kixlogic · AI Intelligence Company</p>
    <h1 class="ai-headline">
      AI intelligence,<br />engineered into <span class="ai-grad">working software.</span>
    </h1>
    <p class="ai-support">
      We design, build, and operate AI systems that reason, act, and ship — agents,
      LLM-powered products, speech interfaces, and the data pipelines underneath them.
      Enterprise-grade intelligence, delivered at speeds enterprises don't believe.
    </p>
    <div class="ai-ctas">
      <a href="/contact/" class="ai-btn ai-btn-primary">Talk to us</a>
      <a href="#platforms" class="ai-btn ai-btn-ghost">See it running</a>
    </div>
  </div>
</section>

<!-- Stats -->
<section class="ai-stats" aria-label="Kixlogic in numbers">
  <div class="container ai-stats-inner">
    <div class="ai-stat"><strong>5</strong><span>AI platforms in production</span></div>
    <div class="ai-stat"><strong>2,400+</strong><span>roles AI-enriched &amp; syndicated</span></div>
    <div class="ai-stat"><strong>6</strong><span>industries served</span></div>
    <div class="ai-stat"><strong>Same&#8209;week</strong><span>idea-to-production cadence</span></div>
  </div>
</section>

<!-- Capabilities -->
<section class="ai-caps section" id="capabilities">
  <div class="container">
    <header class="ai-section-head">
      <p class="ai-eyebrow">Capabilities</p>
      <h2>What we build</h2>
      <p class="ai-section-sub">
        Every capability below is proven the only way that counts — by software
        running in production today.
      </p>
    </header>
    <div class="ai-caps-grid">
      {capabilities.map((c) => (
        <article class="ai-cap">
          <h3>{c.title}</h3>
          <p>{c.body}</p>
          <p class="ai-cap-proof">{c.proof}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Platforms -->
<section class="ai-platforms section" id="platforms">
  <div class="container">
    <header class="ai-section-head">
      <p class="ai-eyebrow">Platforms</p>
      <h2>Our intelligence, in the wild</h2>
      <p class="ai-section-sub">
        We don't just build AI for clients — we run our own AI products in five
        industries. They are our credentials.
      </p>
    </header>
    <div class="ai-plat-grid">
      {platforms.map((p) => (
        <a href={p.href} class="ai-plat">
          <div class="ai-plat-top">
            <span class="ai-plat-tag">{p.tag}</span>
            {p.live
              ? <span class="ai-plat-live"><span class="ai-dot" aria-hidden="true"></span>Live</span>
              : <span class="ai-plat-soon">{p.status}</span>}
          </div>
          <h3>{p.name}</h3>
          <p>{p.line}</p>
          <span class="ai-plat-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Process -->
<section class="ai-process section" id="process">
  <div class="container">
    <header class="ai-section-head">
      <p class="ai-eyebrow">Method</p>
      <h2>How intelligence ships</h2>
    </header>
    <ol class="ai-proc-grid">
      {process_.map((s) => (
        <li class="ai-proc">
          <span class="ai-proc-n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Stack -->
<section class="ai-stack" aria-label="Technology stack">
  <div class="container ai-stack-inner">
    <p class="ai-stack-label">Built on</p>
    <ul class="ai-stack-list">
      {stack.map((s) => <li>{s}</li>)}
    </ul>
  </div>
</section>

<!-- CTA -->
<section class="ai-cta" id="contact">
  <div class="ai-cta-glow" aria-hidden="true"></div>
  <div class="container ai-cta-inner">
    <h2>Put intelligence to work.</h2>
    <p>
      Whether it's one of our platforms or an AI system built for your business —
      tell us what should be smarter. We respond within one business day.
    </p>
    <div class="ai-ctas">
      <a href="/contact/" class="ai-btn ai-btn-primary">Start the conversation</a>
      <a href="/pricing/" class="ai-btn ai-btn-ghost">See pricing</a>
    </div>
  </div>
</section>

<BlogTeaser />

<style>
/* ── Shared dark tokens ─────────────────────────────────────────── */
.ai-hero, .ai-stats, .ai-caps, .ai-platforms, .ai-process, .ai-stack, .ai-cta {
  --dk-bg: #04141b;
  --dk-bg-2: #072028;
  --dk-card: rgba(255, 255, 255, 0.035);
  --dk-card-border: rgba(120, 200, 225, 0.14);
  --dk-text: #e8f1f4;
  --dk-muted: #9fb8c2;
  --dk-dim: #6d8893;
  --dk-accent: #35c4e8;
  --dk-accent-deep: #0c7a94;
}

.ai-eyebrow {
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--dk-accent);
  margin: 0 0 0.9rem;
}

.ai-ctas { display: flex; flex-wrap: wrap; gap: 0.85rem; }

.ai-btn {
  display: inline-block;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 1rem;
  padding: 0.8rem 1.6rem;
  border-radius: 8px;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}
.ai-btn:hover { transform: translateY(-1px); }
.ai-btn-primary {
  background: linear-gradient(135deg, var(--dk-accent), var(--dk-accent-deep));
  color: #04141b;
}
.ai-btn-ghost {
  color: var(--dk-text);
  border: 1px solid var(--dk-card-border);
  background: rgba(255, 255, 255, 0.02);
}
.ai-btn-ghost:hover { border-color: var(--dk-accent); }

.ai-section-head { max-width: 42rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
.ai-section-head h2 {
  font-family: var(--font-display);
  font-size: clamp(1.7rem, 3.4vw, 2.4rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--dk-text);
  margin: 0 0 0.75rem;
}
.ai-section-sub { color: var(--dk-muted); font-size: 1.05rem; line-height: 1.6; }

/* ── Hero ───────────────────────────────────────────────────────── */
.ai-hero {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(90rem 40rem at 85% -20%, rgba(12, 122, 148, 0.35), transparent 60%),
    linear-gradient(180deg, #04141b 0%, #072028 100%);
  padding: clamp(5rem, 14vh, 8.5rem) 0 clamp(4rem, 9vh, 6rem);
}
.ai-hero-glow {
  position: absolute;
  inset: auto -20% -60% -20%;
  height: 34rem;
  background: radial-gradient(50% 60% at 50% 100%, rgba(53, 196, 232, 0.18), transparent 70%);
  pointer-events: none;
}
.ai-hero-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(120, 200, 225, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(120, 200, 225, 0.05) 1px, transparent 1px);
  background-size: 44px 44px;
  mask-image: radial-gradient(70% 60% at 50% 35%, #000 30%, transparent 75%);
  -webkit-mask-image: radial-gradient(70% 60% at 50% 35%, #000 30%, transparent 75%);
  pointer-events: none;
}
.ai-hero-inner { position: relative; max-width: 52rem; }
.ai-headline {
  font-family: var(--font-display);
  font-size: clamp(2.4rem, 6vw, 4rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.08;
  color: var(--dk-text);
  margin: 0 0 1.25rem;
}
.ai-grad {
  background: linear-gradient(100deg, var(--dk-accent) 10%, #7ee2f9 50%, var(--dk-accent-deep) 95%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.ai-support {
  font-size: clamp(1.05rem, 2vw, 1.2rem);
  line-height: 1.65;
  color: var(--dk-muted);
  max-width: 40rem;
  margin: 0 0 2.25rem;
}

/* ── Stats ──────────────────────────────────────────────────────── */
.ai-stats {
  background: var(--dk-bg-2);
  border-top: 1px solid rgba(120, 200, 225, 0.10);
  border-bottom: 1px solid rgba(120, 200, 225, 0.10);
}
.ai-stats-inner {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  gap: 1.5rem 2rem;
  padding: clamp(1.75rem, 4vw, 2.5rem) var(--container-pad, 1.25rem);
}
.ai-stat strong {
  display: block;
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 3.5vw, 2.4rem);
  font-weight: 700;
  color: var(--dk-accent);
  letter-spacing: -0.02em;
}
.ai-stat span { color: var(--dk-muted); font-size: 0.95rem; }

/* ── Capabilities ───────────────────────────────────────────────── */
.ai-caps { background: var(--dk-bg); padding-top: clamp(3.5rem, 7vw, 5.5rem); padding-bottom: clamp(3.5rem, 7vw, 5.5rem); }
.ai-caps-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
  gap: 1.25rem;
}
.ai-cap {
  background: var(--dk-card);
  border: 1px solid var(--dk-card-border);
  border-radius: 14px;
  padding: 1.6rem 1.5rem;
  transition: border-color 0.2s ease, transform 0.2s ease;
}
.ai-cap:hover { border-color: rgba(53, 196, 232, 0.45); transform: translateY(-2px); }
.ai-cap h3 {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--dk-text);
  margin: 0 0 0.6rem;
}
.ai-cap p { color: var(--dk-muted); font-size: 0.97rem; line-height: 1.6; margin: 0 0 0.9rem; }
.ai-cap-proof {
  color: var(--dk-dim);
  font-size: 0.88rem !important;
  line-height: 1.55 !important;
  border-top: 1px solid rgba(120, 200, 225, 0.10);
  padding-top: 0.85rem;
  margin-bottom: 0 !important;
}

/* ── Platforms ──────────────────────────────────────────────────── */
.ai-platforms { background: var(--dk-bg-2); padding-top: clamp(3.5rem, 7vw, 5.5rem); padding-bottom: clamp(3.5rem, 7vw, 5.5rem); }
.ai-plat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
  gap: 1.25rem;
}
.ai-plat {
  position: relative;
  display: block;
  background: var(--dk-card);
  border: 1px solid var(--dk-card-border);
  border-radius: 14px;
  padding: 1.5rem 1.5rem 1.4rem;
  transition: border-color 0.2s ease, transform 0.2s ease;
}
.ai-plat:hover { border-color: rgba(53, 196, 232, 0.5); transform: translateY(-2px); }
.ai-plat-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.9rem;
}
.ai-plat-tag {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--dk-accent);
}
.ai-plat-live {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.78rem;
  font-weight: 600;
  color: #63e0a2;
}
.ai-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: #63e0a2;
  box-shadow: 0 0 8px rgba(99, 224, 162, 0.8);
}
.ai-plat-soon { font-size: 0.78rem; font-weight: 600; color: var(--dk-dim); }
.ai-plat h3 {
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--dk-text);
  margin: 0 0 0.5rem;
}
.ai-plat p { color: var(--dk-muted); font-size: 0.95rem; line-height: 1.55; margin: 0; padding-right: 1.5rem; }
.ai-plat-arrow {
  position: absolute;
  right: 1.3rem; bottom: 1.1rem;
  color: var(--dk-accent);
  font-size: 1.1rem;
  transition: transform 0.2s ease;
}
.ai-plat:hover .ai-plat-arrow { transform: translateX(3px); }

/* ── Process ────────────────────────────────────────────────────── */
.ai-process { background: var(--dk-bg); padding-top: clamp(3.5rem, 7vw, 5.5rem); padding-bottom: clamp(3.5rem, 7vw, 5.5rem); }
.ai-proc-grid {
  list-style: none;
  margin: 0; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1.25rem;
}
.ai-proc {
  border-left: 2px solid rgba(53, 196, 232, 0.35);
  padding: 0.25rem 0 0.25rem 1.15rem;
}
.ai-proc-n {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.12em;
  color: var(--dk-accent);
}
.ai-proc h3 {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--dk-text);
  margin: 0.35rem 0 0.45rem;
}
.ai-proc p { color: var(--dk-muted); font-size: 0.94rem; line-height: 1.6; margin: 0; }

/* ── Stack ──────────────────────────────────────────────────────── */
.ai-stack {
  background: var(--dk-bg-2);
  border-top: 1px solid rgba(120, 200, 225, 0.10);
  border-bottom: 1px solid rgba(120, 200, 225, 0.10);
}
.ai-stack-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem 1.75rem;
  padding-top: 1.4rem;
  padding-bottom: 1.4rem;
}
.ai-stack-label {
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dk-dim);
  margin: 0;
}
.ai-stack-list {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem 0.6rem;
  margin: 0; padding: 0;
}
.ai-stack-list li {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--dk-muted);
  border: 1px solid var(--dk-card-border);
  border-radius: 999px;
  padding: 0.35rem 0.9rem;
}

/* ── CTA ────────────────────────────────────────────────────────── */
.ai-cta {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #04141b 0%, #062633 100%);
  padding: clamp(4rem, 9vw, 6.5rem) 0;
  text-align: center;
}
.ai-cta-glow {
  position: absolute;
  inset: auto -10% -50% -10%;
  height: 26rem;
  background: radial-gradient(50% 60% at 50% 100%, rgba(53, 196, 232, 0.16), transparent 70%);
  pointer-events: none;
}
.ai-cta-inner { position: relative; max-width: 40rem; margin: 0 auto; }
.ai-cta h2 {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 2.6rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--dk-text);
  margin: 0 0 1rem;
}
.ai-cta p { color: var(--dk-muted); font-size: 1.05rem; line-height: 1.6; margin: 0 0 2rem; }
.ai-cta .ai-ctas { justify-content: center; }

@media (prefers-reduced-motion: reduce) {
  .ai-btn, .ai-cap, .ai-plat, .ai-plat-arrow { transition: none; }
}
</style>
