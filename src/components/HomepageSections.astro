---
import BlogTeaser from './BlogTeaser.astro';
import MarketingBillboard from './MarketingBillboard.astro';

const products = [
  {
    name: 'Kixlogic Hired',
    line: 'Applicant tracking for teams that hire without an enterprise IT budget.',
    href: '/hired/',
    soon: false,
  },
  {
    name: 'Renumify',
    line: 'Compensation intelligence — market ranges, offer scoring, equity, and compression.',
    href: '/renumify/',
    soon: false,
  },
  {
    name: 'Kixlogic Sourcer',
    line: 'AI candidate sourcing that finds, ranks, and shortlists people for any role.',
    href: '/sourcer/',
    soon: false,
  },
  {
    name: 'PigskinGPT',
    line: 'Football intelligence — analysis and insight for the modern game.',
    href: '/pigskingpt/',
    soon: false,
  },
  {
    name: 'ScientificGigs',
    line: 'Most cost-effective life-science job board — from $149 vs legacy $490–$880.',
    href: '/scientificgigs/',
    soon: false,
  },
  {
    name: 'Kixlogic Venue',
    line: 'Age and identity verification for venues and events.',
    href: '/venue/',
    soon: true,
  },
];
---

<!-- Hero — company first, typography-led -->
<section class="co-hero" aria-label="Kixlogic">
  <div class="container co-hero-inner">
    <p class="co-brand">Kixlogic</p>
    <h1 class="co-headline">AI Intelligence Software</h1>
    <p class="co-support">
      Enterprise-level products for SMBs — at non-enterprise prices.
    </p>
    <div class="co-ctas">
      <a href="/contact/" class="btn btn-primary">Contact us</a>
      <a href="#products" class="btn btn-outline">Explore products</a>
    </div>
  </div>
</section>

<MarketingBillboard
  ariaLabel="AI Intelligence"
  line1="There's AI."
  line2Em="AI Intelligence."
  chipFrom="AI"
  chipTo="AI Intelligence"
  sub="Kixlogic builds AI Intelligence Software — not chatbots. Software that reasons, acts, and delivers enterprise-grade outcomes for SMBs."
/>

<!-- Products -->
<section class="co-products section" id="products">
  <div class="container">
    <header class="co-section-head">
      <h2>Products</h2>
      <p>Distinct tools from one company.</p>
    </header>

    <ul class="co-product-list">
      {products.map((p) => (
        <li>
          <a href={p.href} class="co-product-row">
            <span class="co-product-name">
              {p.name}
              {p.soon && <span class="co-soon">Coming soon</span>}
            </span>
            <span class="co-product-line">{p.line}</span>
            <span class="co-product-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Sourcer spotlight — dedicated homepage band -->
<section class="co-sourcer" id="sourcer" aria-label="Kixlogic Sourcer">
  <div class="co-sourcer-plane" aria-hidden="true"></div>
  <div class="container co-sourcer-inner">
    <p class="co-sourcer-eyebrow">Kixlogic Sourcer · AI candidate sourcing</p>
    <h2 class="co-sourcer-title">Describe the role. Get a ranked shortlist — not another page of keyword hits.</h2>
    <p class="co-sourcer-sub">
      Sourcer is an AI sourcing agent inside the Hired suite. Paste a natural-language brief;
      it searches public talent signals, enriches and filters matches, then ranks people you can
      shortlist and outreach — for any role, with life-sciences sources available when the job is scientific.
    </p>
    <ol class="co-sourcer-steps">
      <li>
        <span class="co-sourcer-num">1</span>
        <div>
          <strong>Define the hire</strong>
          <p>Describe who you need in plain language, or load criteria from a job posting.</p>
        </div>
      </li>
      <li>
        <span class="co-sourcer-num">2</span>
        <div>
          <strong>AI searches &amp; ranks</strong>
          <p>Sourcer finds candidates across public profiles and networks, then scores fit with evidence — not Boolean spam.</p>
        </div>
      </li>
      <li>
        <span class="co-sourcer-num">3</span>
        <div>
          <strong>Shortlist &amp; act</strong>
          <p>Review a ranked shortlist with quality gates, then move people into outreach from Hired.</p>
        </div>
      </li>
    </ol>
    <ul class="co-sourcer-benefits">
      <li>Hours saved vs manual LinkedIn and Boolean hunting</li>
      <li>Better fit — ranked shortlists with evidence, not keyword soup</li>
      <li>Lite Chrome extension — save LinkedIn profiles you view into Sourced (not applicants)</li>
      <li>Paid suite add-on with usage-metered AI plans for heavy volume</li>
    </ul>
    <div class="co-ctas co-sourcer-ctas">
      <a href="/sourcer/" class="btn btn-primary">Learn more about Sourcer</a>
      <a href="/pricing/#sourcer" class="btn btn-outline co-sourcer-outline">See Sourcer pricing</a>
      <a href="https://app.kixlogic.com/dashboard" class="btn btn-outline co-sourcer-outline">Open in Hired</a>
    </div>
  </div>
</section>

<!-- Approach -->
<section class="co-build section section-grey" id="approach">
  <div class="container co-build-inner">
    <h2>Enterprise capability.<br />SMB accessibility.</h2>
    <div class="co-build-copy">
      <p>
        We build AI intelligence software for companies that need the same hiring,
        compensation, and sourcing power the Fortune 500 buys — without the price,
        the consultants, or the six-month rollout.
      </p>
      <p>
        Ship products that go live the same day. Charge what a growing business
        can actually afford.
      </p>
    </div>
  </div>
</section>

<!-- Closer -->
<section class="co-trust section" id="contact">
  <div class="container co-trust-inner">
    <h2>Ready to work with Kixlogic?</h2>
    <p>
      Tell us what you are building — hiring, pay decisions, sourcing, or something next.
      We respond within one business day.
    </p>
    <div class="co-ctas">
      <a href="/contact/" class="btn btn-primary">Contact us</a>
      <a href="#products" class="btn btn-outline">Explore products</a>
    </div>
  </div>
</section>

<BlogTeaser />

<style>
/* ── Hero ───────────────────────────────────────────────────────── */
.co-hero {
  background: #fff;
  border-bottom: none;
  padding: clamp(4.5rem, 12vh, 7.5rem) 0 clamp(3rem, 7vh, 4.5rem);
}

.co-hero-inner {
  max-width: 44rem;
}

.co-brand {
  font-family: var(--font-display);
  font-size: clamp(2.75rem, 7vw, 4.5rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.05;
  color: var(--teal);
  margin: 0 0 0.75rem;
}

.co-headline {
  font-family: var(--font-display);
  font-size: clamp(1.35rem, 2.8vw, 1.85rem);
  font-weight: 600;
  letter-spacing: -0.02em;
  color: #000;
  margin: 0 0 1rem;
}

.co-support {
  font-size: clamp(1.05rem, 2vw, 1.2rem);
  line-height: 1.55;
  color: var(--text-muted);
  max-width: 32rem;
  margin: 0 0 2rem;
}

.co-ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

/* ── Products ───────────────────────────────────────────────────── */
.co-section-head {
  margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  max-width: 36rem;
}
.co-section-head h2 {
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 700;
  color: var(--teal);
  margin-bottom: 0.5rem;
}
.co-section-head p {
  color: var(--text-muted);
  font-size: 1.05rem;
}

.co-product-list {
  list-style: none;
  border-top: 1px solid var(--border);
}
.co-product-list li {
  border-bottom: 1px solid var(--border);
}
.co-product-row {
  display: grid;
  grid-template-columns: minmax(11rem, 0.85fr) 1.5fr auto;
  gap: 1rem 2rem;
  align-items: baseline;
  padding: 1.35rem 0;
  transition: color var(--transition);
}
.co-product-row:hover .co-product-name {
  color: var(--teal);
}
.co-product-name {
  font-family: var(--font-display);
  font-size: clamp(1.05rem, 1.8vw, 1.2rem);
  font-weight: 700;
  letter-spacing: -0.015em;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
}
.co-soon {
  font-family: var(--font-body);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--text-muted);
  border: 1px solid var(--border);
  padding: 0.15rem 0.4rem;
}
.co-product-line {
  color: var(--text-muted);
  font-size: 0.975rem;
  line-height: 1.5;
}
.co-product-arrow {
  color: var(--text-dim);
  font-size: 1.1rem;
  transition: transform var(--transition), color var(--transition);
}
.co-product-row:hover .co-product-arrow {
  color: var(--teal);
  transform: translateX(3px);
}

/* ── Sourcer spotlight ──────────────────────────────────────────── */
.co-sourcer {
  position: relative;
  overflow: hidden;
  isolation: isolate;
  background: var(--teal);
  color: #fff;
  padding: clamp(3.25rem, 8vw, 5.25rem) 0;
}
.co-sourcer-plane {
  position: absolute;
  inset: 0;
  z-index: 0;
  background:
    radial-gradient(ellipse 70% 90% at 100% 0%, rgba(255, 255, 255, 0.1), transparent 55%),
    radial-gradient(ellipse 50% 60% at 0% 100%, rgba(0, 0, 0, 0.18), transparent 50%),
    linear-gradient(135deg, var(--teal-deep) 0%, var(--teal) 45%, var(--teal-mid) 100%);
  pointer-events: none;
}
.co-sourcer-inner {
  position: relative;
  z-index: 1;
  max-width: 52rem;
}
.co-sourcer-eyebrow {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.72);
  margin: 0 0 0.85rem;
}
.co-sourcer-title {
  font-family: var(--font-display);
  font-size: clamp(1.55rem, 3.5vw, 2.35rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.15;
  color: #fff;
  margin: 0 0 1rem;
  max-width: 36rem;
}
.co-sourcer-sub {
  font-size: clamp(1rem, 1.7vw, 1.12rem);
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.88);
  max-width: 40rem;
  margin: 0 0 1.75rem;
}
.co-sourcer-steps {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin: 0 0 1.5rem;
  padding: 0;
}
.co-sourcer-steps li {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 12px;
  padding: 1.15rem 1.1rem;
}
.co-sourcer-num {
  width: 1.75rem;
  height: 1.75rem;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
  font-size: 0.8rem;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.co-sourcer-steps strong {
  display: block;
  font-size: 0.98rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 0.3rem;
}
.co-sourcer-steps p {
  font-size: 0.9rem;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.75);
  margin: 0;
}
.co-sourcer-benefits {
  list-style: none;
  margin: 0 0 1.75rem;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}
.co-sourcer-benefits li {
  font-size: 0.95rem;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.9);
  padding-left: 1.15rem;
  position: relative;
}
.co-sourcer-benefits li::before {
  content: "✓";
  position: absolute;
  left: 0;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.95);
}
.co-sourcer-ctas .btn-primary {
  background: #fff;
  color: var(--teal-deep);
  border-color: #fff;
}
.co-sourcer-ctas .btn-primary:hover {
  background: rgba(255, 255, 255, 0.92);
  color: var(--teal-deep);
}
.co-sourcer-outline {
  color: #fff !important;
  border-color: rgba(255, 255, 255, 0.45) !important;
  background: transparent !important;
}
.co-sourcer-outline:hover {
  background: rgba(255, 255, 255, 0.12) !important;
  border-color: rgba(255, 255, 255, 0.7) !important;
  color: #fff !important;
}

/* ── Approach ───────────────────────────────────────────────────── */
.co-build-inner {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: start;
}
.co-build-inner h2 {
  font-size: clamp(1.5rem, 3vw, 2.15rem);
  font-weight: 700;
  line-height: 1.2;
}
.co-build-copy p {
  color: var(--text-muted);
  font-size: 1.05rem;
  line-height: 1.65;
  margin-bottom: 1rem;
  max-width: 36rem;
}
.co-build-copy p:last-child {
  margin-bottom: 0;
}

/* ── Closer ─────────────────────────────────────────────────────── */
.co-trust {
  background: #fff;
  border-top: 1px solid var(--border);
}
.co-trust-inner {
  max-width: 36rem;
}
.co-trust h2 {
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 700;
  margin-bottom: 0.75rem;
}
.co-trust p {
  color: var(--text-muted);
  font-size: 1.05rem;
  line-height: 1.6;
  margin-bottom: 1.75rem;
}

@media (max-width: 860px) {
  .co-product-row {
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 0.35rem 1rem;
  }
  .co-product-line {
    grid-column: 1 / -1;
    grid-row: 2;
  }
  .co-product-arrow {
    grid-column: 2;
    grid-row: 1;
  }
  .co-sourcer-steps {
    grid-template-columns: 1fr;
  }
  .co-build-inner {
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
}
</style>
