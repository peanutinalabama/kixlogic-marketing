---
import BlogTeaser from './BlogTeaser.astro';

// 2026-08-30 redesign (Charles): bold colors, Zynga-style product-forward,
// NO dark pages. Apple apps front and center, then Kixlogic ATS and
// Renumify, with an AI-innovation section keeping the lab identity.
// House rule unchanged: no invented numbers - every claim is a real system.

const apps = [
  {
    name: 'LilyFi',
    tag: 'Voice Budgeting',
    line: 'Envelope budgeting you can talk to — say what you spent, Lily logs it and speaks it back.',
    href: '/lilyfi/',
    icon: '/apps/lilyfi.png',
    badge: 'On the App Store',
    live: true,
    tint: '#e8f7e0',
    ring: '#8bc34a',
  },
  {
    name: 'Pixalary',
    tag: 'Picture-Reveal Race',
    line: 'A picture hides under 50 tiles. Answer questions, uncover it, name it first — solo or live vs friends.',
    href: '/pixalary/',
    icon: '/apps/pixalary.png',
    badge: 'Coming soon',
    live: false,
    tint: '#eceafb',
    ring: '#7c6ce8',
  },
  {
    name: 'Bingopalooza',
    tag: 'Skill Bingo',
    line: 'Luck deals the cards, skill wins them. Earn every square against a room that never sits still.',
    href: '/bingopalooza/',
    icon: '/apps/bingopalooza.png',
    badge: 'Coming soon',
    live: false,
    tint: '#eaf0fd',
    ring: '#5b7cfa',
  },
  {
    name: 'Auravo',
    tag: 'AI Language Coach',
    line: 'Speak from minute one. Real conversation, gentle corrections, a tutor with endless patience.',
    href: '/auravo/',
    icon: '/apps/auravo.png',
    badge: 'Coming soon',
    live: false,
    tint: '#e7f0fb',
    ring: '#2f7de1',
  },
  {
    name: 'ScientificGigs',
    tag: 'Life-Science Job Board',
    line: 'AI-enriched science jobs with Google Jobs syndication — the cost-effective way to hire researchers.',
    href: '/scientificgigs/',
    icon: '/apps/scientificgigs.png',
    badge: 'Live on the web',
    live: true,
    tint: '#e4f6ef',
    ring: '#12b886',
  },
  {
    name: 'PigskinGPT',
    tag: 'College Football AI',
    line: 'Ask anything about college football — schedules, matchups, and takes powered by AI.',
    href: '/pigskingpt/',
    icon: '/apps/pigskingpt.png',
    badge: 'Coming soon',
    live: false,
    tint: '#fdeee2',
    ring: '#e8762d',
  },
];

const platforms = [
  {
    name: 'Kixlogic ATS',
    tag: 'Hiring, End to End',
    line: 'Applicant tracking with AI résumé scoring, plus an autonomous sourcing agent that builds ranked shortlists from a sentence.',
    href: '/hired/',
    icon: '/apps/ats.png',
    color: '#0a5f75',
  },
  {
    name: 'Renumify',
    tag: 'Compensation Intelligence',
    line: 'Market ranges, offer scoring, equity and compression analysis — pay decisions with evidence behind them.',
    href: '/renumify/',
    icon: '/apps/renumify.png',
    color: '#0d2340',
  },
  {
    name: 'Workforce Hub',
    tag: 'HR Command Center',
    line: 'Employee intranet plus a one-screen command center — time off, time clock, safety, training, documents, and onboarding for small manufacturers.',
    href: 'https://hub.kixlogic.com',
    icon: '/apps/workforcehub.png',
    color: '#16233f',
  },
];

const ai = [
  {
    title: 'AI Agents & Automation',
    body: 'Autonomous agents that search, enrich, rank, and act — with evidence attached to every decision.',
    proof: 'Running now in Sourcer, our AI candidate-sourcing agent.',
  },
  {
    title: 'LLM Product Engineering',
    body: 'Frontier models built into real products — structured outputs, guardrails, fallbacks, and cost ceilings.',
    proof: 'Running now in Auravo, where every spoken turn is a governed model call.',
  },
  {
    title: 'Speech & Data Pipelines',
    body: 'On-device speech fused with cloud reasoning, and enrichment pipelines that keep AI grounded in fresh data.',
    proof: 'Running now across LilyFi voice logging and ScientificGigs listings.',
  },
];
---

<!-- Hero -->
<section class="kx-hero">
  <div class="kx-hero-tiles" aria-hidden="true">
    <span class="t t1"></span><span class="t t2"></span><span class="t t3"></span>
    <span class="t t4"></span><span class="t t5"></span><span class="t t6"></span>
  </div>
  <div class="container kx-hero-inner">
    <h1>Apps people love.<br /><span class="kx-blue">Software business runs on.</span></h1>
    <p class="kx-hero-sub">
      Kixlogic builds mobile games and apps for everyone — and AI-powered
      platforms that run the everyday work of business. Designed, shipped, and
      operated by one team.
    </p>
    <div class="kx-ctas">
      <a href="#apps" class="kx-btn kx-btn-blue">See our apps</a>
      <a href="/contact/" class="kx-btn kx-btn-line">Talk to us</a>
    </div>
  </div>
</section>

<span id="products" class="kx-anchor" aria-hidden="true"></span>

<!-- Apps & Games -->
<section class="kx-apps section" id="apps">
  <div class="container">
    <header class="kx-head">
      <h2>Apps &amp; Games</h2>
      <p>Games and apps for everyone — on iPhone and the web.</p>
    </header>
    <div class="kx-app-grid">
      {apps.map((a) => (
        <a href={a.href} class="kx-app" style={`--tint:${a.tint};--ring:${a.ring}`}>
          <img src={a.icon} alt={`${a.name} app icon`} width="128" height="128" loading="lazy" />
          <div class="kx-app-body">
            <span class="kx-app-tag">{a.tag}</span>
            <h3>{a.name}</h3>
            <p>{a.line}</p>
            <span class={`kx-badge ${a.live ? 'is-live' : ''}`}>{a.badge}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Business platforms -->
<section class="kx-biz section" id="platforms">
  <div class="container">
    <header class="kx-head">
      <h2>Business Platforms</h2>
      <p>The same product craft, pointed at the problems businesses face every day.</p>
    </header>
    <div class="kx-biz-grid">
      {platforms.map((p) => (
        <a href={p.href} class="kx-biz-card">
          <img class="kx-biz-icon" src={p.icon} alt={`${p.name} icon`}
               width="64" height="64" loading="lazy" />
          <div>
            <span class="kx-app-tag" style={`color:${p.color}`}>{p.tag}</span>
            <h3>{p.name}</h3>
            <p>{p.line}</p>
          </div>
          <span class="kx-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
    <div class="kx-pub" id="publishing">
      <span class="kx-pub-emoji" aria-hidden="true">📚</span>
      <div>
        <span class="kx-app-tag" style="color:#b0620f">Coming Soon</span>
        <h3>Kixlogic Publishing</h3>
        <p>
          The newest arm of Kixlogic: a publishing house that harnesses the
          power of AI-assisted authoring — bringing new books and stories to
          readers with the same product craft behind everything we ship.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- AI innovation -->
<section class="kx-ai section" id="ai">
  <div class="container">
    <header class="kx-head">
      <h2>The AI Lab</h2>
      <p>
        Every Kixlogic product comes out of the same lab: AI product
        innovation, engineered into working software and run in production.
      </p>
    </header>
    <div class="kx-ai-grid">
      {ai.map((c) => (
        <article class="kx-ai-card">
          <h3>{c.title}</h3>
          <p>{c.body}</p>
          <p class="kx-proof">{c.proof}</p>
        </article>
      ))}
    </div>
    <div class="kx-ctas kx-center">
      <a href="/contact/" class="kx-btn kx-btn-blue">Build with us</a>
    </div>
  </div>
</section>

<!-- CTA band -->
<section class="kx-band">
  <div class="container kx-band-inner">
    <h2>Something smarter to build?</h2>
    <p>Tell us what it is. We respond within one business day.</p>
    <a href="/contact/" class="kx-btn kx-btn-white">Start the conversation</a>
  </div>
</section>

<BlogTeaser />

<style>
/* ── Bold light tokens (from the new logo) ─────────────────────── */
.kx-hero, .kx-apps, .kx-biz, .kx-ai, .kx-band {
  --blue: #2f7de1;
  --blue-deep: #1d5fc0;
  --navy: #16233f;
  --paper: #ffffff;
  --mist: #f2f6fd;
  --line2: #e3eaf6;
  --mut: #5a6b85;
  --font-big: "Space Grotesk", var(--font-display);
}

.kx-anchor { display: block; height: 0; }

.kx-head { max-width: 46rem; margin: 0 auto clamp(2rem, 4vw, 3rem); text-align: center; }
.kx-head h2 {
  font-family: var(--font-big);
  font-size: clamp(2rem, 4.5vw, 3rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--navy);
  margin: 0 0 0.6rem;
}
.kx-head p { color: var(--mut); font-size: 1.08rem; line-height: 1.6; margin: 0; }

.kx-ctas { display: flex; flex-wrap: wrap; gap: 0.85rem; }
.kx-center { justify-content: center; margin-top: 2rem; }
.kx-btn {
  display: inline-block;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 1.02rem;
  padding: 0.85rem 1.9rem;
  border-radius: 999px;
  transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
}
.kx-btn:hover { transform: translateY(-2px); }
.kx-btn-blue { background: var(--blue); color: #fff; box-shadow: 0 6px 18px rgba(47, 125, 225, 0.35); }
.kx-btn-blue:hover { background: var(--blue-deep); }
.kx-btn-line { color: var(--navy); border: 2px solid var(--line2); background: #fff; }
.kx-btn-line:hover { border-color: var(--blue); color: var(--blue); }
.kx-btn-white { background: #fff; color: var(--blue-deep); box-shadow: 0 6px 18px rgba(10, 30, 60, 0.25); }

/* ── Hero ──────────────────────────────────────────────────────── */
.kx-hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #eaf2fd 0%, #ffffff 90%);
  padding: clamp(4rem, 11vh, 7rem) 0 clamp(3.5rem, 8vh, 5.5rem);
  text-align: center;
}
.kx-hero-tiles { position: absolute; inset: 0; pointer-events: none; }
.kx-hero-tiles .t {
  position: absolute;
  border-radius: 18%;
  opacity: 0.9;
  animation: kx-float 7s ease-in-out infinite;
}
.t1 { width: 64px; height: 64px; background: #5b7cfa; top: 16%; left: 7%; transform: rotate(-9deg); }
.t2 { width: 44px; height: 44px; background: #ffb545; top: 62%; left: 13%; animation-delay: 1.2s; transform: rotate(12deg); }
.t3 { width: 54px; height: 54px; background: #8bc34a; top: 24%; right: 9%; animation-delay: 0.6s; transform: rotate(8deg); }
.t4 { width: 38px; height: 38px; background: #f2649e; top: 66%; right: 15%; animation-delay: 1.8s; transform: rotate(-14deg); }
.t5 { width: 30px; height: 30px; background: #2f7de1; top: 10%; right: 30%; animation-delay: 2.3s; }
.t6 { width: 26px; height: 26px; background: #7c6ce8; top: 78%; left: 42%; animation-delay: 0.9s; }
@keyframes kx-float {
  0%, 100% { translate: 0 0; }
  50% { translate: 0 -14px; }
}
.kx-hero-inner { position: relative; max-width: 52rem; margin: 0 auto; }
.kx-hero h1 {
  font-family: var(--font-big);
  font-size: clamp(2.4rem, 6.5vw, 4.2rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.06;
  color: var(--navy);
  margin: 0 0 1.1rem;
}
.kx-blue { color: var(--blue); }
.kx-hero-sub {
  color: var(--mut);
  font-size: clamp(1.05rem, 2vw, 1.2rem);
  line-height: 1.6;
  max-width: 38rem;
  margin: 0 auto 2rem;
}
.kx-hero .kx-ctas { justify-content: center; }

/* ── Apps & Games ──────────────────────────────────────────────── */
.kx-apps { background: var(--paper); padding-top: clamp(3.5rem, 7vw, 5.5rem); padding-bottom: clamp(3rem, 6vw, 4.5rem); }
.kx-app-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  gap: 1.4rem;
}
.kx-app {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.9rem;
  background: var(--tint);
  border: 2px solid transparent;
  border-radius: 22px;
  padding: 1.8rem 1.4rem 1.5rem;
  transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}
.kx-app:hover {
  transform: translateY(-5px);
  border-color: var(--ring);
  box-shadow: 0 14px 30px rgba(22, 35, 63, 0.12);
}
.kx-app img {
  width: 108px; height: 108px;
  border-radius: 24px;
  box-shadow: 0 10px 22px rgba(22, 35, 63, 0.22);
}
.kx-app-tag {
  display: block;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ring, var(--blue));
  margin-bottom: 0.25rem;
}
.kx-app h3 {
  font-family: var(--font-big);
  font-size: 1.45rem;
  font-weight: 700;
  color: var(--navy);
  margin: 0 0 0.4rem;
}
.kx-app p { color: var(--mut); font-size: 0.95rem; line-height: 1.55; margin: 0 0 0.9rem; }
.kx-badge {
  display: inline-block;
  font-size: 0.78rem;
  font-weight: 800;
  padding: 0.35rem 0.95rem;
  border-radius: 999px;
  background: #fff;
  color: var(--mut);
  border: 1.5px solid var(--line2);
}
.kx-badge.is-live { background: var(--navy); color: #fff; border-color: var(--navy); }

/* ── Business ──────────────────────────────────────────────────── */
.kx-biz { background: var(--mist); padding-top: clamp(3.5rem, 7vw, 5.5rem); padding-bottom: clamp(3rem, 6vw, 4.5rem); }
.kx-biz-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  gap: 1.4rem;
  max-width: 62rem;
  margin: 0 auto;
}
.kx-biz-card {
  position: relative;
  display: flex;
  gap: 1.2rem;
  align-items: flex-start;
  background: #fff;
  border: 2px solid var(--line2);
  border-radius: 20px;
  padding: 1.6rem 1.6rem 1.5rem;
  transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}
.kx-biz-card:hover {
  transform: translateY(-4px);
  border-color: var(--blue);
  box-shadow: 0 14px 30px rgba(22, 35, 63, 0.1);
}
.kx-biz-icon {
  flex: none;
  width: 64px; height: 64px;
  border-radius: 16px;
  box-shadow: 0 8px 18px rgba(22, 35, 63, 0.18);
}
.kx-biz-card h3 {
  font-family: var(--font-big);
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--navy);
  margin: 0.1rem 0 0.4rem;
}
.kx-biz-card p { color: var(--mut); font-size: 0.95rem; line-height: 1.55; margin: 0; padding-right: 1rem; }
.kx-arrow {
  position: absolute;
  right: 1.3rem; bottom: 1.1rem;
  color: var(--blue);
  font-size: 1.2rem;
  transition: transform 0.18s ease;
}
.kx-biz-card:hover .kx-arrow { transform: translateX(4px); }
.kx-also { text-align: center; color: var(--mut); font-size: 0.92rem; margin: 1.6rem 0 0; }
.kx-also a { color: var(--blue); font-weight: 700; }
.kx-pub {
  display: flex;
  gap: 1.2rem;
  align-items: flex-start;
  max-width: 62rem;
  margin: 2rem auto 0;
  background: linear-gradient(160deg, #fff8ee 0%, #fdf1de 100%);
  border: 2px dashed #e8bd7d;
  border-radius: 20px;
  padding: 1.5rem 1.6rem;
}
.kx-pub-emoji { font-size: 2.2rem; line-height: 1; }
.kx-pub h3 {
  font-family: var(--font-big);
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--navy);
  margin: 0.1rem 0 0.4rem;
}
.kx-pub p { color: var(--mut); font-size: 0.95rem; line-height: 1.6; margin: 0; }

/* ── AI Lab ────────────────────────────────────────────────────── */
.kx-ai { background: var(--paper); padding-top: clamp(3.5rem, 7vw, 5.5rem); padding-bottom: clamp(3rem, 6vw, 4.5rem); }
.kx-ai-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  gap: 1.3rem;
}
.kx-ai-card {
  background: linear-gradient(160deg, #f6f9ff 0%, #eef4fd 100%);
  border: 2px solid var(--line2);
  border-radius: 18px;
  padding: 1.5rem 1.4rem;
}
.kx-ai-card h3 {
  font-family: var(--font-big);
  font-size: 1.12rem;
  font-weight: 700;
  color: var(--navy);
  margin: 0 0 0.5rem;
}
.kx-ai-card p { color: var(--mut); font-size: 0.94rem; line-height: 1.6; margin: 0 0 0.8rem; }
.kx-proof {
  color: var(--blue-deep) !important;
  font-size: 0.85rem !important;
  font-weight: 600;
  border-top: 1px solid var(--line2);
  padding-top: 0.75rem;
  margin-bottom: 0 !important;
}

/* ── CTA band ──────────────────────────────────────────────────── */
.kx-band {
  background: linear-gradient(120deg, var(--blue) 0%, #5b7cfa 100%);
  padding: clamp(3.5rem, 8vw, 5.5rem) 0;
  text-align: center;
}
.kx-band h2 {
  font-family: var(--font-big);
  font-size: clamp(1.9rem, 4.5vw, 2.9rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: #fff;
  margin: 0 0 0.7rem;
}
.kx-band p { color: rgba(255, 255, 255, 0.85); font-size: 1.08rem; margin: 0 0 1.8rem; }

@media (prefers-reduced-motion: reduce) {
  .kx-hero-tiles .t { animation: none; }
  .kx-btn, .kx-app, .kx-biz-card, .kx-arrow { transition: none; }
}
</style>
