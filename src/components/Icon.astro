---
// Simple line icons drawn for the firm site (no third-party icon set).
import type { IconName } from '../data/firm';
interface Props { name: IconName; size?: number }
const { name, size = 28 } = Astro.props;
---
<svg class="ic" width={size} height={size} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'search' && <><circle cx="14" cy="14" r="8" /><path d="M20 20l7 7" /><circle cx="14" cy="12" r="2.5" /><path d="M10 18c1-2 2.5-3 4-3s3 1 4 3" /></>}
  {name === 'people' && <><circle cx="11" cy="11" r="4" /><circle cx="22" cy="12" r="3" /><path d="M4 26c0-4 3-7 7-7s7 3 7 7" /><path d="M19 19c3 0 6 2 6 6" /></>}
  {name === 'spark' && <><rect x="5" y="7" width="22" height="16" rx="2" /><path d="M11 27h10" /><path d="M16 11l1.4 3.1 3.1 1.4-3.1 1.4L16 20l-1.4-3.1-3.1-1.4 3.1-1.4z" /></>}
  {name === 'globe' && <><circle cx="16" cy="16" r="11" /><path d="M5 16h22" /><path d="M16 5c3 3 4.5 7 4.5 11s-1.5 8-4.5 11c-3-3-4.5-7-4.5-11S13 8 16 5z" /></>}
  {name === 'code' && <><path d="M11 10l-6 6 6 6" /><path d="M21 10l6 6-6 6" /><path d="M18 7l-4 18" /></>}
  {name === 'gear' && <><circle cx="16" cy="16" r="4" /><path d="M16 4v4M16 24v4M4 16h4M24 16h4M7.5 7.5l2.8 2.8M21.7 21.7l2.8 2.8M7.5 24.5l2.8-2.8M21.7 10.3l2.8-2.8" /></>}
  {name === 'flask' && <><path d="M13 4h6M14 4v8L7 25a2 2 0 0 0 1.8 3h14.4a2 2 0 0 0 1.8-3L18 12V4" /><path d="M10 20h12" /></>}
</svg>
