---
const { active } = Astro.props; // 'hired' | 'renumify' | 'comp' | 'sourcer'
---
<div class="product-toggle-wrap">
  <div class="product-toggle" role="tablist" aria-label="Kixlogic workforce products">
    <a
      href="/hired/"
      class={`product-toggle-btn ${active === 'hired' || active === 'ats' ? 'active' : ''}`}
      aria-current={active === 'hired' || active === 'ats' ? 'page' : undefined}
    >Hired</a>
    <a
      href="/renumify/"
      class={`product-toggle-btn ${active === 'renumify' || active === 'comp' || active === 'cmp' ? 'active' : ''}`}
      aria-current={active === 'renumify' || active === 'comp' || active === 'cmp' ? 'page' : undefined}
    >Renumify</a>
    <a
      href="/sourcer/"
      class={`product-toggle-btn ${active === 'sourcer' ? 'active' : ''}`}
      aria-current={active === 'sourcer' ? 'page' : undefined}
    >Sourcer</a>
  </div>
</div>

<style>
  .product-toggle-wrap {
    display: flex;
    justify-content: center;
    padding: 24px 16px 0;
  }
  .product-toggle {
    display: inline-flex;
    gap: 4px;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 4px;
  }
  .product-toggle-btn {
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: background var(--transition), color var(--transition);
  }
  .product-toggle-btn:hover { color: var(--text); }
  .product-toggle-btn.active {
    background: var(--teal);
    color: #fff;
  }
</style>
