---
/**
 * Full-bleed teal billboard — homepage “There’s X. / Then there’s Y.” band.
 * Reused on product pages with tailored copy.
 */
interface Props {
  line1: string;
  /** Text before the emphasized phrase, e.g. "Then there's " */
  line2Before?: string;
  /** Emphasized phrase with underline, e.g. "AI Intelligence." */
  line2Em: string;
  chipFrom?: string;
  chipTo?: string;
  sub: string;
  ariaLabel?: string;
  /** Subtle “Coming soon” chip (Venue) — keeps the band lively */
  soon?: boolean;
}

const {
  line1,
  line2Before = "Then there's ",
  line2Em,
  chipFrom,
  chipTo,
  sub,
  ariaLabel = 'Product highlight',
  soon = false,
} = Astro.props;

const showMotif = Boolean(chipFrom && chipTo);
---

<section class:list={['mkt-billboard', soon && 'mkt-billboard-soon']} aria-label={ariaLabel}>
  <div class="mkt-billboard-plane" aria-hidden="true"></div>
  <div class="container mkt-billboard-inner">
    {soon && <p class="mkt-billboard-soon-tag">Coming soon</p>}
    <p class="mkt-billboard-line mkt-billboard-a">{line1}</p>
    <p class="mkt-billboard-line mkt-billboard-b">
      {line2Before}<span class="mkt-billboard-em">{line2Em}</span>
    </p>
    {showMotif && (
      <div class="mkt-billboard-motif" aria-hidden="true">
        <span class="mkt-billboard-chip">{chipFrom}</span>
        <span class="mkt-billboard-arrow">
          <svg width="48" height="12" viewBox="0 0 48 12" fill="none">
            <path d="M0 6h40M35 1l10 5-10 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="mkt-billboard-chip mkt-billboard-chip-strong">{chipTo}</span>
      </div>
    )}
    <p class="mkt-billboard-sub">{sub}</p>
  </div>
</section>

<style>
.mkt-billboard {
  position: relative;
  overflow: hidden;
  background: var(--teal);
  color: #fff;
  padding: clamp(3.5rem, 9vw, 6rem) 0;
  isolation: isolate;
}

.mkt-billboard-plane {
  position: absolute;
  inset: 0;
  z-index: 0;
  background:
    radial-gradient(ellipse 70% 90% at 100% 0%, rgba(255, 255, 255, 0.1), transparent 55%),
    radial-gradient(ellipse 50% 60% at 0% 100%, rgba(0, 0, 0, 0.18), transparent 50%),
    linear-gradient(135deg, var(--teal-deep) 0%, var(--teal) 45%, var(--teal-mid) 100%);
  pointer-events: none;
}

.mkt-billboard-plane::after {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    repeating-linear-gradient(
      -18deg,
      transparent,
      transparent 28px,
      rgba(255, 255, 255, 0.03) 28px,
      rgba(255, 255, 255, 0.03) 29px
    );
  opacity: 0.9;
}

.mkt-billboard-inner {
  position: relative;
  z-index: 1;
  max-width: 52rem;
}

.mkt-billboard-soon-tag {
  display: inline-block;
  font-family: var(--font-body);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.1);
  padding: 0.28rem 0.55rem;
  margin: 0 0 1.15rem;
  animation: mktBillboardRise 0.7s ease-out both;
}

.mkt-billboard-line {
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: -0.035em;
  line-height: 1.05;
  margin: 0;
}

.mkt-billboard-a {
  font-size: clamp(1.75rem, 5vw, 3rem);
  font-weight: 600;
  color: rgba(255, 255, 255, 0.55);
  margin-bottom: 0.35rem;
  animation: mktBillboardRise 0.7s ease-out both;
}

.mkt-billboard-b {
  font-size: clamp(2.15rem, 6.5vw, 4rem);
  color: #fff;
  margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  animation: mktBillboardRise 0.7s ease-out 0.12s both;
}

.mkt-billboard-em {
  display: inline;
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
  border-bottom: 3px solid rgba(255, 255, 255, 0.85);
  padding-bottom: 0.05em;
}

.mkt-billboard-motif {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.65rem 0.85rem;
  margin-bottom: clamp(1.35rem, 2.5vw, 1.85rem);
  animation: mktBillboardRise 0.7s ease-out 0.24s both;
}

.mkt-billboard-chip {
  font-family: var(--font-display);
  font-size: clamp(0.8rem, 1.4vw, 0.95rem);
  font-weight: 600;
  letter-spacing: 0.02em;
  color: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.28);
  padding: 0.4rem 0.85rem;
  background: rgba(255, 255, 255, 0.06);
}

.mkt-billboard-chip-strong {
  color: #fff;
  font-weight: 700;
  border-color: rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.12);
}

.mkt-billboard-arrow {
  display: flex;
  color: rgba(255, 255, 255, 0.65);
  animation: mktBillboardArrow 1.4s ease-in-out 0.5s infinite;
}

.mkt-billboard-sub {
  font-size: clamp(1rem, 1.8vw, 1.2rem);
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.88);
  max-width: 36rem;
  margin: 0;
  animation: mktBillboardRise 0.7s ease-out 0.32s both;
}

/* Coming soon: still full teal energy — slightly quieter line 1 only */
.mkt-billboard-soon .mkt-billboard-a {
  color: rgba(255, 255, 255, 0.48);
}

@keyframes mktBillboardRise {
  from {
    opacity: 0;
    transform: translateY(14px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes mktBillboardArrow {
  0%, 100% { transform: translateX(0); opacity: 0.65; }
  50% { transform: translateX(5px); opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .mkt-billboard-a,
  .mkt-billboard-b,
  .mkt-billboard-motif,
  .mkt-billboard-sub,
  .mkt-billboard-arrow,
  .mkt-billboard-soon-tag {
    animation: none;
  }
}

@media (max-width: 480px) {
  .mkt-billboard-b {
    font-size: clamp(1.85rem, 9vw, 2.35rem);
  }
}
</style>
