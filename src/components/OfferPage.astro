---
// The body of a service or industry page: highlighted headline and photo, sections, and a closing call to action.
import { headlineParts, photoUrl, type Offer } from '../data/firm';
import Icon from './Icon.astro';
interface Props { offer: Offer; kind: 'Services' | 'Industries' }
const { offer, kind } = Astro.props;
const parts = headlineParts(offer.headline);
---
<section class="hero hero-split">
  <div class="fw hs-in">
    <div>
      <p class="eyebrow"><span class="ic-chip"><Icon name={offer.icon} size={20} /></span>{kind} · {offer.name}</p>
      <h1 class="display xl">{parts.map((p) => (p.mark ? <mark>{p.text}</mark> : p.text))}</h1>
      <p class="lede">{offer.intro}</p>
      <div class="actions"><a class="pill pill-blue" href="/contact/">{offer.cta}</a></div>
    </div>
    <figure class="photo">
      <img src={photoUrl(offer.photo, 900, 1000)} srcset={`${photoUrl(offer.photo, 600, 667)} 600w, ${photoUrl(offer.photo, 900, 1000)} 900w`} sizes="(max-width:980px) 100vw, 480px" alt={offer.photoAlt} width="900" height="1000" loading="eager" />
    </figure>
  </div>
</section>

{offer.sections.map((s, i) => (
  <section class={`band ${i % 2 ? 'soft' : ''}`}>
    <div class="fw split">
      <div><h2 class="display md">{s.title}</h2></div>
      <div class="prose">
        <p>{s.body}</p>
        {s.points && <ul class="ticks">{s.points.map((p) => <li>{p}</li>)}</ul>}
      </div>
    </div>
  </section>
))}

<section class="band navy">
  <div class="fw">
    <h2 class="display lg">Ready when <mark style="color:#0A1B4D">you are.</mark></h2>
    <p class="lede">Tell us what you need and we will reply with next steps.</p>
    <div style="margin-top:32px"><a class="pill" href="/contact/">Contact us</a></div>
  </div>
</section>
