---
import { entryPath, tagPath, type LibraryItem } from '../lib/library';

interface Props { item: LibraryItem }
const { item } = Astro.props;
// Cover images keep the page's own shape, so the grid does not jump as they load.
const aspect = item.ratio > 0 ? item.ratio : 0.77;
---
<article class="lib-card">
  <a class="lib-cover" href={entryPath(item.slug)} aria-label={`Read ${item.title}`}>
    <img src={item.cover} alt={`Cover of ${item.title}`} loading="lazy" decoding="async" style={`aspect-ratio:${aspect.toFixed(3)}`} />
  </a>
  <div class="lib-body">
    <h3><a href={entryPath(item.slug)}>{item.title}</a></h3>
    <p>{item.description}</p>
    <p class="lib-meta">{item.pages} {item.pages === 1 ? 'page' : 'pages'}
      {item.tags.slice(0, 3).map((t) => (<a class="lib-tag" href={tagPath(t)}>{t}</a>))}
    </p>
  </div>
</article>

<style>
  .lib-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; transition: transform .18s ease, box-shadow .18s ease; }
  .lib-card:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(15, 23, 42, .12); }
  .lib-cover { display: block; background: #0b1220; padding: 1rem; text-align: center; }
  .lib-cover img { display: inline-block; max-width: 100%; max-height: 260px; width: auto; height: auto; border-radius: 4px; box-shadow: 0 8px 22px rgba(0, 0, 0, .45); background: #1b2230; }
  .lib-body { padding: 1rem 1.1rem 1.2rem; display: flex; flex-direction: column; gap: .35rem; flex: 1; }
  .lib-body h3 { margin: 0; font-size: 1.08rem; line-height: 1.3; }
  .lib-body h3 a { color: #111827; text-decoration: none; }
  .lib-body h3 a:hover { color: #1d4ed8; }
  .lib-body p { margin: 0; color: #4b5563; font-size: .93rem; line-height: 1.55; }
  .lib-meta { margin-top: auto !important; padding-top: .5rem; font-size: .82rem !important; color: #6b7280 !important; display: flex; flex-wrap: wrap; gap: .35rem .5rem; align-items: center; }
  .lib-tag { background: #eef3ff; color: #1d4ed8; border-radius: 999px; padding: .1rem .6rem; text-decoration: none; font-weight: 600; }
  .lib-tag:hover { background: #dbe7ff; }
</style>
