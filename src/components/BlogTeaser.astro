---
// DISABLED 2026-08-30: api.kixlogic.com (the mothballed ATS container) is
// dead, and even a timed-out fetch taxed every homepage load ~2s. The blog
// redesign replaces this component with static in-repo content - do not
// re-enable the fetch; replace the component then.
let posts: any[] = [];
---
{posts.length > 0 && (
  <section class="section section-grey" id="blog">
    <div class="container">
      <div class="blog-teaser-header">
        <h2 class="section-heading">From the blog</h2>
        <a href="/blog/" class="blog-teaser-link">View all posts →</a>
      </div>
      <div class="blog-teaser-grid">
        {posts.map((post: any) => {
          const dt = new Date(post.published_at);
          const date = dt.toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
          });
          return (
            <a href={`/blog/${post.slug}/`} class="blog-teaser-card">
              <time datetime={dt.toISOString()}>{date}</time>
              <h3>{post.title}</h3>
              <p>{post.excerpt || post.meta_description || ''}</p>
              <span class="blog-teaser-cta">Read article →</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
.blog-teaser-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}
.section-heading {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 700;
}
.blog-teaser-link {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--teal);
}
.blog-teaser-link:hover { text-decoration: underline; }
.blog-teaser-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
.blog-teaser-card {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  background: transparent;
  border: none;
  border-bottom: 1px solid var(--border);
  padding: 0.25rem 0 1.25rem;
  transition: border-color var(--transition);
}
.blog-teaser-card:hover { border-bottom-color: var(--teal); }
.blog-teaser-card time {
  font-size: 0.75rem;
  color: var(--text-muted);
}
.blog-teaser-card h3 {
  font-size: 1.05rem;
  font-weight: 700;
  line-height: 1.35;
}
.blog-teaser-card p {
  font-size: 0.875rem;
  color: var(--text-muted);
  line-height: 1.55;
  flex: 1;
}
.blog-teaser-cta {
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--teal);
  margin-top: 0.25rem;
}
@media (max-width: 900px) {
  .blog-teaser-grid { grid-template-columns: 1fr; }
}
</style>
